-- ウィンドウの大きさ（幅と高さ、ピクセル）
module Window where


-- いまのウィンドウの幅と高さを受け取る
--
--   main = App.app { init, update, view, onStart = Window.size Resized }
foreign import size :: (Int -> Int -> msg) -> Cmd msg
  = "(toMsg) => (dispatch) => dispatch(toMsg(window.innerWidth)(window.innerHeight))"

-- ウィンドウの大きさが変わるたびに、幅と高さを受け取る
--
--   subscriptions _ = Window.onResize Resized
foreign import onResize :: (Int -> Int -> msg) -> Sub msg
  = "(toMsg) => $rt.sub('Window.onResize', (s) => toMsg(s[0])(s[1]), (emit) => { const f = () => emit([window.innerWidth, window.innerHeight]); window.addEventListener('resize', f); return () => window.removeEventListener('resize', f); })"
