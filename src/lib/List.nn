module List where


-- 最初の要素。空なら Nothing
--
--   List.head [3, 1, 2]    -- Just 3
--   List.head []           -- Nothing
head :: [a] -> Maybe a
head (x : _) = Just x
head []      = Nothing

-- 最後の要素。空なら Nothing
--
--   List.last [3, 1, 2]    -- Just 2
last :: [a] -> Maybe a
last [x]      = Just x
last (_ : xs) = last xs
last []       = Nothing

-- 条件に合う最初の要素。なければ Nothing
--
--   List.find (hasId id) todos             -- where hasId id t = t.id == id
find :: (a -> Bool) -> [a] -> Maybe a
find p (x : xs)
  | p x       = Just x
  | otherwise = find p xs
find _ [] = Nothing

-- 位置（0 から）と要素を受け取る関数を、それぞれに当てる
--
--   List.indexedMap row items    -- where row i item = …
foreign import indexedMap :: (Int -> a -> b) -> [a] -> [b] = "(f) => (xs) => xs.map((x, i) => f(i)(x))"

-- 組のリストから、1 つ目が key に等しい最初の組の 2 つ目を探す
--
--   List.lookup "b" [("a", 1), ("b", 2)]    -- Just 2
lookup :: a -> [(a, b)] -> Maybe b
lookup key ((k, v) : rest)
  | k == key  = Just v
  | otherwise = lookup key rest
lookup _ [] = Nothing


-- 要素それぞれに関数を当て、Just の中身だけを集める
--
--   List.filterMap String.toInt ["1", "x", "3"]    -- [1, 3]
filterMap :: (a -> Maybe b) -> [a] -> [b]
filterMap f (x : xs) = keep (f x)
  where
    keep (Just y) = y : filterMap f xs
    keep Nothing  = filterMap f xs
filterMap _ [] = []

-- 条件に合うものと合わないものに分ける
--
--   List.partition (.done) todos    -- (済んだもの, まだのもの)
partition :: (a -> Bool) -> [a] -> ([a], [a])
partition p xs = (filter p xs, filter (not . p) xs)

-- いちばん大きい要素。空なら Nothing
--
--   List.maximum [3, 7, 2]    -- Just 7
maximum :: Ord a => [a] -> Maybe a
maximum (x : xs) = Just (foldl max x xs)
maximum []       = Nothing

-- いちばん小さい要素。空なら Nothing
--
--   List.minimum [3, 7, 2]    -- Just 2
minimum :: Ord a => [a] -> Maybe a
minimum (x : xs) = Just (foldl min x xs)
minimum []       = Nothing

-- 要素の間に値を挟む
--
--   List.intersperse 0 [1, 2, 3]    -- [1, 0, 2, 0, 3]
foreign import intersperse :: a -> [a] -> [a] = "(sep) => (xs) => xs.flatMap((x, i) => (i === 0 ? [x] : [sep, x]))"
-- 同じ値を n 個並べる
--
--   List.repeat 3 "★"    -- ["★", "★", "★"]
foreign import repeat :: Int -> a -> [a] = "(n) => (x) => Array.from({ length: Math.max(0, n) }, () => x)"
-- 2 回目以降に出てくる同じ値を取り除く（== と同じ比べ方。順は保つ）
--
--   List.unique [1, 2, 1, 3]    -- [1, 2, 3]
foreign import unique :: [a] -> [a] = "(xs) => xs.filter((x, i) => xs.findIndex((y) => $rt.eq(x, y)) === i)"

-- 位置（0 から）の要素を取り除く。範囲の外なら何もしない
--
--   List.removeAt 1 ["a", "b", "c"]    -- ["a", "c"]
foreign import removeAt :: Int -> [a] -> [a] = "(i) => (xs) => xs.filter((_, j) => j !== i)"
-- 位置（0 から）の要素に関数を当てる。範囲の外なら何もしない
--
--   List.updateAt 0 toggle todos
foreign import updateAt :: Int -> (a -> a) -> [a] -> [a] = "(i) => (f) => (xs) => xs.map((x, j) => (j === i ? f(x) : x))"
