-- テスト。test/ の下のファイルで tests :: [Test] を export すると、nene test が実行する
--
--   tests :: [Test]
--   tests =
--     [ Test.equal "/guide は使い方のページ" (route (url ["guide"])) Guide
--     , Test.group "カウンター"
--         [ Test.equal "増やす" (update Increment init).count 1
--         ]
--     ]
module Test where


-- 名前、実際の値、期待する値。2 つの値が等しければ通る
foreign import equal :: String -> a -> a -> Test
  = "(name) => (actual) => (expected) => ({ $test: 'equal', name, actual, expected })"

-- テストに見出しをつけてまとめる
foreign import group :: String -> [Test] -> Test
  = "(name) => (tests) => ({ $test: 'group', name, tests })"
