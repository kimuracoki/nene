-- 値と JSON の文字列を行き来する。どう変換するかは型から決まる
--   Int・Float・String・Bool・()・リスト・タプル・レコード・Maybe（null かフィールドなし）・Dict String a
--   引数のないコンストラクタだけの data 型（コンストラクタの名前の文字列）
module Json where


foreign import encode :: Json a => a -> String
  = "(d) => (x) => JSON.stringify(d.enc(x))"

-- うまく読めなかったときは、どこが違ったかを Err で返す
foreign import decode :: Json a => String -> Result String a
  = "(d) => (text) => $rt.decodeJson(d, text)"
