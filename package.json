{
  "name": "nene-lang",
  "version": "0.1.5",
  "type": "module",
  "bin": {
    "nene": "bin/nene.js"
  },
  "scripts": {
    "dev": "cd examples && node ../src/cli.ts dev",
    "build": "cd examples && node ../src/cli.ts build --out ../dist/examples",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "build:package": "rm -rf build && tsc -p tsconfig.build.json && cp -R src/lib build/lib",
    "prepack": "npm run build:package",
    "bump": "node scripts/release.mjs bump",
    "release": "node scripts/release.mjs release"
  },
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./vite": "./build/vite.js",
    "./compiler": "./build/compiler.js",
    "./cli": "./bin/nene.js"
  },
  "description": "Simple rules. Beautiful structures. — Haskell の書き心地と JSX の見やすさを両立させる、UI 向けの関数型言語",
  "files": [
    "bin",
    "build",
    "runtime",
    "template",
    "editors/nvim",
    "docs"
  ],
  "dependencies": {
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "nene-lang-ui": "file:./ui",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimuracoki/nene.git"
  },
  "homepage": "https://github.com/kimuracoki/nene#readme",
  "bugs": {
    "url": "https://github.com/kimuracoki/nene/issues"
  },
  "license": "MIT",
  "author": "kimuracoki",
  "keywords": [
    "nene",
    "language",
    "functional",
    "haskell",
    "jsx",
    "elm",
    "ui",
    "vite"
  ]
}
