{
  "comments": {
    "lineComment": "--",
    "blockComment": ["{-", "-}"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "{-", "close": " -}", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(\\bwhere\\s*$|=\\s*$|<[A-Za-z][^/>]*>\\s*$)",
    "decreaseIndentPattern": "^\\s*</"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*--.*$",
      "action": { "indent": "none", "appendText": "-- " }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_']*"
}
