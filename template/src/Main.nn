module Main (main) where

-- 部品は nene-lang-ui（公式の部品集）のもの。一覧は node_modules/nene-lang-ui/README.md
import Ui.Button (Variant(..))
import qualified Ui.Icon as Icon
import Ui.IconButton
import Ui.Theme (Tone(..))


type Model = Int

data Msg = Increment | Decrement | Reset


update :: Msg -> Model -> Model
update Increment n = n + 1
update Decrement n = n - 1
update Reset _     = 0


view :: Model -> Html Msg
view n =
  <main class={css.page}>
    <Column gap={XL} align={Center}>
      <Column gap={S} align={Center}>
        <img class={css.logo} src="/nene.svg" alt="" />
        <h1 class={css.title}>{{name}}</h1>
        <p class={css.tagline}>Simple rules. Beautiful structures.</p>
      </Column>

      <section class={css.counter}>
        <Row gap={L} align={Center}>
          <IconButton icon={Icon.remove} label="減らす" variant={Filled} tone={Primary} size={L} onClick={Decrement} />
          <p class={css.count}>{show n}</p>
          <IconButton icon={Icon.add} label="増やす" variant={Filled} tone={Primary} size={L} onClick={Increment} />
        </Row>
        <Button variant={Plain} tone={Neutral} size={S} onClick={Reset}>リセット</Button>
      </section>

      <Grid columns={3} gap={M} collapse={M} class={css.steps}>
        <Step title="書く" file="src/Main.nn">保存すると、すぐに画面へ反映されます。</Step>
        <Step title="確かめる" file="npm run check">型のエラーを、場所と直し方つきで知らせます。</Step>
        <Step title="公開する" file="npm run build">dist/ をそのまま静的ホスティングに置けます。</Step>
      </Grid>
    </Column>
  </main>


-- このファイルの中だけで使う部品
step :: { title :: String, file :: String } -> [Html msg] -> Html msg
step props children =
  <article class={css.step}>
    <Column gap={S}>
      <h2 class={css.stepTitle}>{props.title}</h2>
      <code class={css.file}>{props.file}</code>
      <p class={css.stepBody}>{children}</p>
    </Column>
  </article>


main :: Program Model Msg
main = App.app { init = 0, update, view }


style
  /* 色は nene-lang-ui と同じ変数で決める。--primary を変えると、ボタンなどの色も変わる */
  :root {
    --primary: light-dark(#7c5cff, #9d85ff);
    --accent: #ff6fa8;
  }
  body {
    min-height: 100vh;
    font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif;
    line-height: 1.6;
    color: var(--text);
    background:
      radial-gradient(60rem 30rem at 50% -10rem, color-mix(in srgb, var(--primary) 18%, transparent), transparent),
      var(--background);
  }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 72px 16px 48px;
  }
  .logo {
    width: 72px;
    height: 72px;
    filter: drop-shadow(0 8px 24px color-mix(in srgb, var(--primary) 40%, transparent));
  }
  .title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline { color: var(--muted); }

  .counter {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 28px 40px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: 0 12px 40px rgb(30 20 80 / .08);
  }
  .count {
    min-width: 3ch;
    font-size: 3rem;
    font-weight: 800;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .steps { width: 100%; }
  .step {
    height: 100%;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color .15s, transform .15s;
  }
  .step:hover {
    border-color: color-mix(in srgb, var(--primary) 50%, var(--border));
    transform: translateY(-2px);
  }
  .step-title { font-size: 1rem; }
  .file {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    color: var(--primary);
    font-size: .8125rem;
  }
  .step-body {
    color: var(--muted);
    font-size: .875rem;
  }
