module TextField (TextFieldProps, textField) where


type TextFieldProps msg =
  { value   :: String
  , onInput :: String -> msg
  , label   :: String       = ""
  , error   :: Maybe String = Nothing
  }


textField :: TextFieldProps msg -> Html msg
textField props =
  <label style={wrapper}>
    <Column gap={XS}>
      <span style={caption}>{props.label}</span>
      <input style={box} value={props.value} placeholder={props.label} onInput={props.onInput} />
      <ErrorText message={props.error} />
    </Column>
  </label>
  where
    box
      | hasError  = { boxBase | border = Danger }
      | otherwise = boxBase

    hasError = props.error /= Nothing
    boxBase  = Style { padding = S, radius = S, border = Border, background = Surface }
    caption  = Style { font = S, color = Muted }
    wrapper  = Style { width = Fill }


errorText :: { message :: Maybe String } -> Html msg
errorText { message = Just m }  = <span style={errorStyle}>{m}</span>
errorText { message = Nothing } = <></>


errorStyle :: Style
errorStyle = Style { font = S, color = Danger }
