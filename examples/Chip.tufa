module Chip (ChipProps, Hue(..), chip) where


data Hue = Gray | Blue | Amber | Red

type ChipProps msg =
  { onClick  :: Maybe msg = Nothing
  , selected :: Bool      = False
  , hue      :: Hue       = Gray
  }


chip :: ChipProps msg -> [Html msg] -> Html msg
chip props children =
  <Body action={props.onClick}>{children}</Body>
  where
    -- 押せるチップはボタンに、押せないチップはただの文字にする
    body { action = Just msg } kids = <button class={look} type="button" onClick={msg}>{kids}</button>
    body { action = Nothing } kids  = <span class={look}>{kids}</span>

    look
      | props.selected = classes [css.chip, hueClass props.hue, css.selected]
      | otherwise      = classes [css.chip, hueClass props.hue]


hueClass :: Hue -> Class
hueClass Gray  = css.gray
hueClass Blue  = css.blue
hueClass Amber = css.amber
hueClass Red   = css.red


style
  .chip {
    display: inline-block;
    padding: 2px 10px;
    border: 1px solid var(--border, #d0d5dd);
    border-radius: 999px;
    background: none;
    color: var(--hue);
    font-size: .875rem;
  }
  .gray  { --hue: var(--muted, #6b7280); }
  .blue  { --hue: var(--primary, #3563e9); }
  .amber { --hue: var(--warning, #c27c0e); }
  .red   { --hue: var(--danger, #d93f3f); }
  .selected {
    border-color: var(--hue);
    background: var(--hue);
    color: white;
  }
