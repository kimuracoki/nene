module IconButton (iconButton) where

import Icon


iconButton :: { icon :: String, label :: String, onClick :: msg } -> Html msg
iconButton props =
  <button class={css.iconButton} type="button" title={props.label} onClick={props.onClick}>
    <Icon name={props.icon} />
  </button>


style
  .icon-button {
    padding: 6px;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--muted, #6b7280);
    transition: background-color .15s, color .15s;
  }
  .icon-button:hover {
    background: var(--hover, rgb(0 0 0 / .06));
    color: var(--text, #1f2328);
  }
