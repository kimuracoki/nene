-- アルバムごとに写真が横に続くギャラリー。写真を押すと大きく表示する
module Gallery (main) where

import IconButton
import Photo (PhotoSize(..))


type Image =
  { id       :: Int
  , src      :: String
  , caption  :: String
  , favorite :: Bool
  }

type Album =
  { title  :: String
  , images :: [Image]
  }

type Model =
  { albums   :: [Album]
  , selected :: Maybe Image
  }

data Msg
  = Select Image
  | Close
  | ToggleFavorite Int


init :: Model
init =
  { albums =
      [ { title = "山", images = map picture [ (10, "朝の稜線"), (29, "霧"), (46, "湖"), (54, "尾根道"), (57, "夕暮れ") ] }
      , { title = "街", images = map picture [ (43, "交差点"), (48, "窓辺"), (76, "路地"), (103, "駅") ] }
      ]
  , selected = Nothing
  }
  where
    picture (id, caption) =
      { id
      , src      = "https://picsum.photos/id/" ++ show id ++ "/640/420"
      , caption
      , favorite = False
      }


-- UPDATE

update :: Msg -> Model -> Model
update (Select image) model = { model | selected = Just image }
update Close model          = { model | selected = Nothing }
update (ToggleFavorite id) model =
  { model
  | albums   = map toggleIn model.albums
  , selected = Maybe.map toggle model.selected
  }
  where
    toggleIn album = { album | images = map toggle album.images }

    toggle image
      | image.id == id = { image | favorite = not image.favorite }
      | otherwise      = image


-- VIEW

view :: Model -> Html Msg
view model =
  <Stack>
    <Column gap={XL} style={page}>
      <h1>ギャラリー</h1>
      {map albumRow model.albums}
    </Column>
    <Viewer image={model.selected} />
  </Stack>
  where
    page = Style { padding = L }


albumRow :: Album -> Html Msg
albumRow album =
  <section>
    <Column gap={S}>
      <Row align={Center}>
        <h2>{album.title}</h2>
        <Spacer />
        <span style={muted}>{count}</span>
      </Row>
      <Scroll direction={Horizontal}>
        <Row gap={M} style={strip}>
          {map thumb album.images}
        </Row>
      </Scroll>
    </Column>
  </section>
  where
    count = show (length album.images) ++ " 枚"
    muted = Style { color = Muted }
    strip = Style { padding = S }

    -- リストの要素 1 つを描く関数
    thumb image =
      <Photo src={image.src} alt={image.caption} badge={favoriteBadge image} onClick={Select image} />

    favoriteBadge image
      | image.favorite = Just "★"
      | otherwise      = Nothing


-- 選んだ写真を、一覧の上に重ねて表示する
viewer :: { image :: Maybe Image } -> Html Msg
viewer { image = Nothing } = <></>
viewer { image = Just image } =
  <Column align={Center} style={backdrop}>
    <Column gap={M} style={panel}>
      <Photo src={image.src} alt={image.caption} size={Large} onClick={Close} />
      <Row gap={S} align={Center}>
        <p>{image.caption}</p>
        <Spacer />
        <IconButton icon={favoriteIcon} label="お気に入り" onClick={ToggleFavorite image.id} />
        <IconButton icon="close" label="閉じる" onClick={Close} />
      </Row>
    </Column>
  </Column>
  where
    backdrop = Style { padding = XL, background = Background }
    panel    = Style { padding = M, background = Surface, radius = L, shadow = XL }

    favoriteIcon
      | image.favorite = "star"
      | otherwise      = "star_border"


main :: Program Model Msg
main = App.sandbox { init, update, view }
