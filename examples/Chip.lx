module Chip (ChipProps, chip) where


type ChipProps msg =
  { onClick  :: Maybe msg = Nothing
  , selected :: Bool      = False
  , color    :: Color     = Muted
  }


chip :: ChipProps msg -> [Html msg] -> Html msg
chip props children =
  <Body action={props.onClick}>{children}</Body>
  where
    -- 押せるチップはボタンに、押せないチップはただの文字にする
    body { action = Just msg } kids = <button style={look} type="button" onClick={msg}>{kids}</button>
    body { action = Nothing } kids  = <span style={look}>{kids}</span>

    look
      | props.selected = { base | background = props.color, color = Surface, border = props.color }
      | otherwise      = { base | color = props.color, border = Border }

    base = Style { paddingX = S, paddingY = XS, radius = XL, font = S }
