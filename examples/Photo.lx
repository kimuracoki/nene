-- 主部品は photo。外部からは <Photo> として使える
module Photo (PhotoProps, PhotoSize(..), photo) where


data PhotoSize = Thumb | Large

type PhotoProps msg =
  { src     :: String
  , alt     :: String
  , onClick :: msg
  , size    :: PhotoSize    = Thumb
  , badge   :: Maybe String = Nothing
  }


photo :: PhotoProps msg -> Html msg
photo props =
  <figure style={frame} onClick={props.onClick}>
    <Stack align={Start} justify={End}>
      <img src={props.src} alt={props.alt} style={image} />
      <Badge label={props.badge} />
    </Stack>
  </figure>
  where
    frame = Style { radius = M, shadow = S, hover = Style { shadow = L } }
    image = Style { width = imageWidth props.size, radius = M }


-- このファイルの中だけで使う部品
badge :: { label :: Maybe String } -> Html msg
badge { label = Just s } = <span style={look}>{s}</span>
  where
    look = Style { padding = XS, color = Warning, font = L }
badge { label = Nothing } = <></>


imageWidth :: PhotoSize -> Length
imageWidth Thumb = Px 200
imageWidth Large = Px 640
