module Button (ButtonProps, Variant(..), button) where

import Icon


data Variant = Contained | Outlined | TextButton


-- onClick 以外はデフォルト値があるので、呼び出し側で省略できる
type ButtonProps msg =
  { onClick   :: msg
  , variant   :: Variant      = Contained
  , color     :: Color        = Primary
  , startIcon :: Maybe String = Nothing
  , disabled  :: Bool         = False
  }


button :: ButtonProps msg -> [Html msg] -> Html msg
button props children =
  <button style={look} type="button" disabled={props.disabled} onClick={props.onClick}>
    <Row gap={XS} align={Center}>
      <StartIcon name={props.startIcon} />
      {children}
    </Row>
  </button>
  where
    look = variantStyle props.variant props.color


-- このファイルの中だけで使う部品
startIcon :: { name :: Maybe String } -> Html msg
startIcon { name = Just name } = <Icon name={name} />
startIcon { name = Nothing }   = <></>


variantStyle :: Variant -> Color -> Style
variantStyle Contained c  = { base | background = c, color = Surface, hover = Style { shadow = M } }
variantStyle Outlined c   = { base | border = c, color = c, hover = Style { background = Background } }
variantStyle TextButton c = { base | color = c, hover = Style { background = Background } }


base :: Style
base = Style { paddingX = M, paddingY = S, radius = S, weight = Bold }
