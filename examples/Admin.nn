style
  .side {
    flex: 0 0 240px;
    padding: 16px 8px;
    border-right: 1px solid var(--divider);
  }
  @media (max-width: 900px) {
    .side { display: none; }
  }
  .page {
    flex: 1 1 0;
    min-width: 0;
    max-width: 1120px;
    padding: 32px 24px 96px;
  }
  .title { font-size: 1.75rem; font-weight: 500; }
  .muted { color: var(--muted); }
  .stat { font-size: 2rem; font-weight: 500; line-height: 1.2; }
  .toolbar { padding: 16px; }
  .search { flex: 1 1 280px; max-width: 360px; }
  .email { color: var(--muted); font-size: .875rem; }
  .selection {
    padding: 8px 16px;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .footer {
    padding: 8px 16px;
    border-top: 1px solid var(--divider);
  }
