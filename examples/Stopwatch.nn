-- ストップウォッチ。タイマー・キーボード・ブラウザへの保存・テーマを使う例
module Stopwatch (main) where

import Ui.Button (Variant(..))
import Ui.Theme (Tone(..))


type Model =
  { running  :: Bool
  , elapsed  :: Int        -- ミリ秒
  , lastTick :: Maybe Int
  , laps     :: [Int]      -- 新しいものが先頭
  , best     :: Maybe Int  -- いちばん速いラップ。ブラウザに保存する
  }

data Msg
  = Toggle
  | Lap
  | Reset
  | Tick Int
  | KeyPressed String
  | BestLoaded (Maybe String)


init :: Model
init = { running = False, elapsed = 0, lastTick = Nothing, laps = [], best = Nothing }


-- UPDATE

update :: Msg -> Model -> Model
update Toggle model           = { model | running = not model.running, lastTick = Nothing }
update (KeyPressed " ") model = update Toggle model
update (Tick now) model       = { model | elapsed = model.elapsed + since model.lastTick, lastTick = Just now }
  where
    since (Just t) = now - t
    since Nothing  = 0
update Lap model
  | model.running = { model | laps = lap : model.laps, best = Just (faster model.best) }
  | otherwise     = model
  where
    lap = model.elapsed - sum model.laps

    faster (Just b) = min b lap
    faster Nothing  = lap
update Reset model              = { model | running = False, elapsed = 0, lastTick = Nothing, laps = [] }
update (BestLoaded saved) model = { model | best = Maybe.andThen String.toInt saved }
update _ model                  = model


effect :: Msg -> Model -> Cmd Msg
effect Lap { best = Just b } = Storage.set "stopwatch.best" (show b)
effect _ _                   = Cmd.none


subscriptions :: Model -> Sub Msg
subscriptions model = Sub.batch [ Keyboard.onKeyDown KeyPressed, ticking model ]
  where
    ticking { running = True } = Time.every 30 Tick
    ticking _                  = Sub.none


-- VIEW

view :: Model -> Html Msg
view model =
  <Column gap={L} align={Center} class={css.page}>
    <p class={css.clock}>{format model.elapsed}</p>
    <Row gap={S}>
      <Button onClick={Toggle}>{toggleLabel}</Button>
      <Button variant={Outlined} onClick={Lap} disabled={stopped}>ラップ</Button>
      <Button variant={Plain} tone={Danger} onClick={Reset}>リセット</Button>
    </Row>
    <p class={css.hint}>スペースキーでも開始・停止できます</p>
    <BestTime best={model.best} />
    <ol>{List.indexedMap lapRow oldestFirst}</ol>
  </Column>
  where
    stopped     = not model.running
    oldestFirst = reverse model.laps

    toggleLabel
      | model.running = "停止"
      | otherwise     = "開始"


bestTime :: { best :: Maybe Int } -> Html msg
bestTime { best = Just ms } = <p>{label}</p>
  where
    label = "ベストラップ " ++ format ms
bestTime { best = Nothing } = <></>


lapRow :: Int -> Int -> Html msg
lapRow i ms =
  <li class={css.lap}>
    <Row gap={L}>
      <span class={css.number}>{lapName}</span>
      <span>{format ms}</span>
    </Row>
  </li>
  where
    lapName = "ラップ " ++ show (i + 1)


-- 12345 ミリ秒 → "00:12.34"
format :: Int -> String
format ms = pad (ms // 60000) ++ ":" ++ pad (mod (ms // 1000) 60) ++ "." ++ pad (mod (ms // 10) 100)
  where
    pad n
      | n < 10    = "0" ++ show n
      | otherwise = show n


main :: Program Model Msg
main =
  App.app
    { init
    , update
    , view
    , effect
    , subscriptions
    , onStart = Storage.get "stopwatch.best" BestLoaded
    }


style
  :root {
    --primary: #22c55e;
    --danger: #f87171;
    --text: #e6e8eb;
    --muted: #9aa3ae;
    --background: #15181c;
    color-scheme: dark;
  }
  body {
    font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif;
    color: var(--text);
    background: var(--background);
  }
  ol { padding: 0; list-style: none; }
  .page { padding: var(--space-xl); }
  .clock {
    font-size: 3rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hint {
    font-size: .875rem;
    color: var(--muted);
  }
  .lap { padding: var(--space-xs) 0; }
  .number { color: var(--muted); }
