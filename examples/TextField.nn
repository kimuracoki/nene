module TextField (TextFieldProps, textField) where


type TextFieldProps msg =
  { value   :: String
  , onInput :: String -> msg
  , label   :: String       = ""
  , error   :: Maybe String = Nothing
  }


textField :: TextFieldProps msg -> Html msg
textField props =
  <label class={css.field}>
    <Column gap={XS}>
      <span class={css.caption}>{props.label}</span>
      <input class={box} value={props.value} placeholder={props.label} onInput={props.onInput} />
      <ErrorText message={props.error} />
    </Column>
  </label>
  where
    box
      | props.error /= Nothing = classes [css.box, css.invalid]
      | otherwise              = css.box


errorText :: { message :: Maybe String } -> Html msg
errorText { message = Just m }  = <span class={css.error}>{m}</span>
errorText { message = Nothing } = <></>


style
  .field { flex: 1; }
  .caption {
    font-size: .875rem;
    color: var(--muted, #6b7280);
  }
  .box {
    padding: 8px;
    border: 1px solid var(--border, #d0d5dd);
    border-radius: 6px;
    background: var(--surface, white);
  }
  .invalid { border-color: var(--danger, #d93f3f); }
  .error {
    font-size: .875rem;
    color: var(--danger, #d93f3f);
  }
