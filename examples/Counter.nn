module Counter (main) where

import Button (Variant(..))


data Msg = Increment | Decrement | Reset

type Model = Int


init :: Model
init = 0


update :: Msg -> Model -> Model
update Increment n = n + 1
update Decrement n
  | n > 0     = n - 1
  | otherwise = 0
update Reset _ = 0


view :: Model -> Html Msg
view n =
  <Column gap={M} align={Center} class={css.page}>
    <h1>カウンター</h1>
    <p class={count}>{show n}</p>
    <Row gap={S}>
      <Button onClick={Decrement} disabled={atZero}>-</Button>
      <Button onClick={Increment}>+</Button>
      <Button variant={Outlined} onClick={Reset}>リセット</Button>
    </Row>
  </Column>
  where
    atZero = n == 0

    count
      | n >= 10   = classes [css.count, css.big]
      | otherwise = css.count


main :: Program Model Msg
main = App.app { init, update, view }


style
  :root {
    --primary: #3563e9;
    --warning: #c27c0e;
    --danger: #d93f3f;
    --text: #1f2328;
    --muted: #6b7280;
    --surface: #ffffff;
    --background: #f3f4f6;
    --border: #d0d5dd;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --text: #e6e8eb;
      --muted: #9aa3ae;
      --surface: #1e2227;
      --background: #15181c;
      --border: #39404a;
    }
  }
  body {
    font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif;
    line-height: 1.5;
    color: var(--text);
    background: var(--background);
  }
  .page { padding: var(--space-xl); }
  .count {
    font-size: 2.5rem;
    font-weight: 700;
  }
  .big { color: var(--danger); }
