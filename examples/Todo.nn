-- elm-sample の「タスク」画面に相当するもの。タスクはブラウザに保存され、読み直しても残る
module Todo (main) where

-- 部品は nene-lang-ui（公式の部品集）のもの。import すると、その主部品をタグで使える（<Button> など）
import Ui.Button (Variant(..))
import Ui.Card
import Ui.Chip
import qualified Ui.Icon as Icon
import Ui.IconButton
import Ui.TextField
import Ui.Theme (Tone(..))


data Priority = High | Medium | Low

data Filter = All | Active | Completed

type Todo =
  { id       :: Int
  , title    :: String
  , priority :: Priority
  , done     :: Bool
  }

type Model =
  { todos  :: [Todo]
  , nextId :: Int
  , draft  :: String
  , error  :: Maybe String
  , filter :: Filter
  }

data Msg
  = DraftChanged String
  | AddTodo
  | ToggleTodo Int Bool
  | Delete Int
  | SetFilter Filter
  | ClearCompleted
  | Loaded (Maybe String)


init :: Model
init =
  { todos  = [ sample 2 "牛乳を買う" High, sample 1 "企画書を読む" Low ]
  , nextId = 3
  , draft  = ""
  , error  = Nothing
  , filter = All
  }
  where
    sample id title priority = { id, title, priority, done = False }


-- UPDATE

update :: Msg -> Model -> Model
update (DraftChanged s) model = { model | draft = s, error = Nothing }
update AddTodo model
  | String.isEmpty title = { model | error = Just "タスク名を入力してください" }
  | otherwise            =
      { model
      | todos  = newTodo : model.todos
      , nextId = model.nextId + 1
      , draft  = ""
      }
  where
    title   = trim model.draft
    newTodo = { id = model.nextId, title, priority = Medium, done = False }
update (ToggleTodo id checked) model = { model | todos = map toggle model.todos }
  where
    toggle t
      | t.id == id = { t | done = checked }
      | otherwise  = t
update (Delete id) model = { model | todos = filter keep model.todos }
  where
    keep t = t.id /= id
update (SetFilter f) model  = { model | filter = f }
update ClearCompleted model = { model | todos = filter (not . (.done)) model.todos }
update (Loaded saved) model = restore (Maybe.andThen (Result.toMaybe . Json.decode) saved)
  where
    restore (Just todos) = { model | todos = todos, nextId = nextIdOf todos }
    restore Nothing      = model
    nextIdOf todos = 1 + Maybe.withDefault 0 (List.maximum (map (.id) todos))


-- タスクが変わったら保存する。Json.encode は型（[Todo]）から JSON を作る
effect :: Msg -> Model -> Cmd Msg
effect (DraftChanged _) _ = Cmd.none
effect (SetFilter _) _    = Cmd.none
effect (Loaded _) _       = Cmd.none
effect _ model            = Storage.set "todos" (Json.encode model.todos)


-- VIEW

view :: Model -> Html Msg
view model =
  <Column gap={L} class={css.page}>
    <h1>タスク</h1>
    <div class={css.progress} role="progressbar" aria-label="完了した割合">
      <div class={css.progressBar} vars={progress} />
    </div>

    <Card>
      <form onSubmit={AddTodo}>
        <Row gap={S} align={End} collapse={S}>
          <TextField label="新しいタスク" value={model.draft} onInput={DraftChanged} error={model.error} />
          <Button startIcon={Just Icon.add} onClick={AddTodo}>追加</Button>
        </Row>
      </form>
    </Card>

    <Card padding={None}>
      <Row gap={S} align={Center} class={css.toolbar}>
        <FilterChip filter={All} label="すべて" />
        <FilterChip filter={Active} label="未完了" />
        <FilterChip filter={Completed} label="完了" />
        <Spacer />
        <Button variant={Plain} tone={Danger} disabled={noneCompleted} onClick={ClearCompleted}>
          完了済みを削除
        </Button>
      </Row>
      <TodoList todos={visible} />
    </Card>
  </Column>
  where
    visible       = filter (matches model.filter) model.todos
    noneCompleted = countOf Completed == 0
    progress      = { done = show (countOf Completed * 100 // max 1 (countOf All)) ++ "%" }
    countOf f     = length (filter (matches f) model.todos)

    -- where の中の部品も、タグで呼べる。model をそのまま使える
    filterChip p =
      <Chip selected={isSelected} onClick={select} tone={Primary}>{chipLabel}</Chip>
      where
        isSelected = model.filter == p.filter
        select     = Just (SetFilter p.filter)
        chipLabel  = p.label ++ " " ++ show (countOf p.filter)


-- このファイルの中だけで使う部品
todoList :: { todos :: [Todo] } -> Html Msg
todoList { todos = [] } =
  <Column align={Center} class={css.empty}>
    <p>表示するタスクはありません</p>
  </Column>
todoList { todos } =
  <ul>
    {map todoItem todos}
  </ul>


todoItem :: Todo -> Html Msg
todoItem todo =
  <li key={show todo.id} class={css.item}>
    <Row gap={S} align={Center}>
      <input type="checkbox" checked={todo.done} onCheck={ToggleTodo todo.id} />
      <span class={title}>{todo.title}</span>
      <Spacer />
      <Chip tone={priorityTone todo.priority}>{priorityLabel todo.priority}</Chip>
      <IconButton icon={Icon.delete} label="削除" onClick={Delete todo.id} />
    </Row>
  </li>
  where
    title
      | todo.done = classes [css.title, css.done]
      | otherwise = css.title


-- HELPERS

matches :: Filter -> Todo -> Bool
matches All       _ = True
matches Active    t = not t.done
matches Completed t = t.done

priorityLabel :: Priority -> String
priorityLabel High   = "高"
priorityLabel Medium = "中"
priorityLabel Low    = "低"

priorityTone :: Priority -> Tone
priorityTone High   = Danger
priorityTone Medium = Warning
priorityTone Low    = Primary


main :: Program Model Msg
main = App.app { init, update, view, effect, onStart = Storage.get "todos" Loaded }


style
  :root {
    --primary: #3563e9;
    --warning: #c27c0e;
    --danger: #d93f3f;
    --text: #1f2328;
    --muted: #6b7280;
    --surface: #ffffff;
    --background: #f3f4f6;
    --border: #d0d5dd;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --text: #e6e8eb;
      --muted: #9aa3ae;
      --surface: #1e2227;
      --background: #15181c;
      --border: #39404a;
    }
  }
  body {
    font-family: system-ui, -apple-system, "Hiragino Sans", sans-serif;
    line-height: 1.5;
    color: var(--text);
    background: var(--background);
  }
  h1 { font-size: 1.75rem; }
  ul { padding: 0; list-style: none; }
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-l);
  }
  .toolbar { padding: var(--space-s); }
  .progress {
    height: 6px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .progress-bar {
    width: var(--done);
    height: 100%;
    background: var(--primary);
    transition: width .3s;
  }
  .empty {
    padding: var(--space-l);
    color: var(--muted);
  }
  .item {
    padding: var(--space-s);
    border-top: 1px solid var(--border);
  }
  .title { overflow-wrap: anywhere; }
  .done {
    color: var(--muted);
    text-decoration: line-through;
  }
