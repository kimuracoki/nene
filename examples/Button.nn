module Button (ButtonProps, Variant(..), Intent(..), button) where

import Icon


data Variant = Contained | Outlined | TextButton

data Intent = Primary | Danger


-- onClick 以外はデフォルト値があるので、呼び出し側で省略できる
type ButtonProps msg =
  { onClick   :: msg
  , variant   :: Variant      = Contained
  , intent    :: Intent       = Primary
  , startIcon :: Maybe String = Nothing
  , disabled  :: Bool         = False
  }


button :: ButtonProps msg -> [Html msg] -> Html msg
button props children =
  <button class={look} type="button" disabled={props.disabled} onClick={props.onClick}>
    <Row gap={XS} align={Center}>
      <StartIcon name={props.startIcon} />
      {children}
    </Row>
  </button>
  where
    look = classes [css.button, variantClass props.variant, intentClass props.intent]


-- このファイルの中だけで使う部品
startIcon :: { name :: Maybe String } -> Html msg
startIcon { name = Just name } = <Icon name={name} />
startIcon { name = Nothing }   = <></>


variantClass :: Variant -> Class
variantClass Contained  = css.contained
variantClass Outlined   = css.outlined
variantClass TextButton = css.text

intentClass :: Intent -> Class
intentClass Primary = css.primary
intentClass Danger  = css.danger


style
  .button {
    padding: 8px 16px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    font-weight: 700;
    transition: background-color .15s, box-shadow .15s;
  }
  .button:disabled {
    opacity: .45;
    cursor: default;
  }
  .primary { --tone: var(--primary, #3563e9); }
  .danger  { --tone: var(--danger, #d93f3f); }

  .contained {
    background: var(--tone);
    color: white;
  }
  .contained:hover:not(:disabled) { box-shadow: 0 4px 12px rgb(0 0 0 / .15); }

  .outlined {
    border-color: var(--tone);
    color: var(--tone);
  }
  .text { color: var(--tone); }
  .outlined:hover:not(:disabled),
  .text:hover:not(:disabled) {
    background: color-mix(in srgb, var(--tone) 8%, transparent);
  }
