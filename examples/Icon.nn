-- アイコン。名前から記号を選ぶだけの簡単なもの
module Icon (icon) where


icon :: { name :: String } -> Html msg
icon { name } = <span class={css.icon}>{glyph name}</span>


glyph :: String -> String
glyph "add"         = "＋"
glyph "delete"      = "✕"
glyph "close"       = "✕"
glyph "star"        = "★"
glyph "star_border" = "☆"
glyph _             = "・"


style
  .icon {
    font-size: 1rem;
    line-height: 1;
  }
