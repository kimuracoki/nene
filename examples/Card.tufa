module Card (CardProps, card) where


type CardProps =
  { flush :: Bool = False   -- True なら内側の余白をなくす
  }


card :: CardProps -> [Html msg] -> Html msg
card props children =
  <section class={look}>
    {children}
  </section>
  where
    look
      | props.flush = css.card
      | otherwise   = classes [css.card, css.padded]


style
  .card {
    background: var(--surface, white);
    border-radius: 10px;
    box-shadow: 0 1px 3px rgb(0 0 0 / .1);
  }
  .padded { padding: var(--space-m); }
