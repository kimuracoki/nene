-- タブ。どれを選んでいるかは model に持つ（0 から数える）
--
--   <Tabs labels={sections} selected={model.tab} onSelect={TabChanged} />
--     where
--       sections = ["概要", "設定", "履歴"]
module Ui.Tabs (TabsProps, tabs) where


type TabsProps msg =
  { labels   :: [String]
  , selected :: Int
  , onSelect :: Int -> msg
  }


tabs :: TabsProps msg -> Html msg
tabs props =
  <div class={css.tabs} role="tablist">
    <Row>{List.indexedMap tab props.labels}</Row>
  </div>
  where
    tab i label = <button class={look} type="button" role="tab" aria-selected={state} onClick={choose}>{label}</button>
      where
        active = i == props.selected
        choose = props.onSelect i
        look
          | active    = classes [css.tab, css.active]
          | otherwise = css.tab
        state
          | active    = "true"
          | otherwise = "false"


style
  .tabs { border-bottom: 1px solid var(--divider); }
  .tab {
    position: relative;
    min-width: 90px;
    min-height: 48px;
    padding: 12px 16px;
    overflow: hidden;
    border: none;
    background: none;
    color: var(--muted);
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: .02857em;
    text-transform: uppercase;
    transition: color .2s var(--ease), background-color .2s var(--ease);
  }
  /* 選ばれたタブの下線 */
  .tab::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transition: transform .3s var(--ease);
  }
  /* 押したときの波紋。押した所（ランタイムが --press-x と --press-y に入れる）から広がり、離すと消える */
  .tab::after {
    content: "";
    position: absolute;
    left: var(--press-x, 50%);
    top: var(--press-y, 50%);
    width: var(--press-size, 0);
    height: var(--press-size, 0);
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    scale: 0;
    pointer-events: none;
  }
  .tab[data-pressed]::after { scale: 1; transition: scale .55s var(--ease); }
  .tab[data-pressed=down]::after { opacity: .3; }
  .tab[data-pressed=up]::after { transition: scale .55s var(--ease), opacity .55s var(--ease); }
  .tab:focus-visible { outline: none; background: var(--hover); }
  .active { color: var(--primary); }
  .active::before { transform: scaleX(1); }
