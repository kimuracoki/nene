-- 画面の上に重ねて出す対話の枠。開いているかどうかは model に持つ
--
--   <Dialog open={model.confirming} title="削除しますか？" onClose={Cancel}>
--     <p>この操作は取り消せません。</p>
--     <Row gap={S} justify={End}>
--       <Button variant={Plain} tone={Neutral} onClick={Cancel}>やめる</Button>
--       <Button tone={Danger} onClick={Confirm}>削除</Button>
--     </Row>
--   </Dialog>
--
-- 背景を押すか、右上のボタンで onClose が届く。Esc で閉じるには Keyboard.onKeyDown を購読する
module Ui.Dialog (DialogProps, dialog) where

import qualified Ui.Icon as Icon
import Ui.IconButton


type DialogProps msg =
  { open    :: Bool
  , onClose :: msg
  , title   :: String = ""
  }


dialog :: DialogProps msg -> [Html msg] -> Html msg
dialog props children = <Body visible={props.open} />
  where
    body { visible = True } =
      <div class={css.overlay}>
        <div class={css.backdrop} onClick={props.onClose} />
        <section class={css.panel} role="dialog" aria-modal="true" aria-label={props.title}>
          <Column gap={M}>
            <Row gap={S} align={Center}>
              <h2 class={css.title}>{props.title}</h2>
              <Spacer />
              <IconButton icon={Icon.close} label="閉じる" size={S} onClick={props.onClose} />
            </Row>
            {children}
          </Column>
        </section>
      </div>
    body { visible = False } = <></>


style
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 16px;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    background: rgb(10 10 20 / .45);
    animation: fade .15s ease-out;
  }
  .panel {
    position: relative;
    width: min(480px, 100%);
    max-height: calc(100vh - 32px);
    overflow: auto;
    padding: 20px 24px 24px;
    border-radius: calc(var(--radius) + 6px);
    background: var(--surface);
    box-shadow: 0 24px 64px rgb(0 0 0 / .25);
    animation: rise .18s ease-out;
  }
  .title { font-size: 1.125rem; font-weight: 700; }
  @keyframes fade { from { opacity: 0; } }
  @keyframes rise { from { opacity: 0; transform: translateY(8px) scale(.98); } }
