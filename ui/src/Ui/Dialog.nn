-- 画面の上に重ねて出す対話の枠。開いているかどうかは model に持つ
--
--   <Dialog open={model.confirming} title="削除しますか？" onClose={Cancel}>
--     <p>この操作は取り消せません。</p>
--     <Row gap={S} justify={End}>
--       <Button variant={Plain} tone={Neutral} onClick={Cancel}>やめる</Button>
--       <Button tone={Danger} onClick={Confirm}>削除</Button>
--     </Row>
--   </Dialog>
--
-- 背景を押すか、右上のボタンで onClose が届く。Esc で閉じるには Keyboard.onKeyDown を購読する
module Ui.Dialog (DialogProps, dialog) where

import qualified Ui.Icon as Icon
import Ui.IconButton


type DialogProps msg =
  { open    :: Bool          -- 開いているか
  , onClose :: msg           -- 背景か右上の × を押したときに届くメッセージ。open を False にする（Esc で閉じるなら Keyboard.onKeyDown を購読する）
  , title   :: String = ""   -- 見出し。空なら出さない
  }


dialog :: DialogProps msg -> [Html msg] -> Html msg
dialog props children = <Body visible={props.open} />
  where
    body { visible = True } =
      <div class={css.overlay}>
        <div class={css.backdrop} onClick={props.onClose} />
        <section class={css.panel} role="dialog" aria-modal="true" aria-label={props.title}>
          <div class={css.header}>
            <Row gap={S} align={Center}>
              <h2 class={css.title}>{props.title}</h2>
              <Spacer />
              <IconButton icon={Icon.close} label="閉じる" size={S} onClick={props.onClose} />
            </Row>
          </div>
          <div class={css.content}>
            <Column gap={M}>{children}</Column>
          </div>
        </section>
      </div>
    body { visible = False } = <></>


style
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1300;
    display: grid;
    place-items: center;
    padding: 32px;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / .5);
    animation: fade .225s var(--ease);
  }
  .panel {
    position: relative;
    width: min(600px, 100%);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-24);
    animation: fade .225s var(--ease);
  }
  .header { padding: 12px 12px 4px 24px; }
  .title { font-size: 1.25rem; font-weight: 500; line-height: 1.6; letter-spacing: .0075em; }
  .content { padding: 0 24px 20px; }
  @keyframes fade { from { opacity: 0; } }
