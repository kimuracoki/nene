-- 画面の左下に短く出す知らせ。出ているかどうかは model に持つ
--
--   <Snackbar open={model.saved} message="保存しました" onClose={HideSaved} />
--   <Snackbar open={model.removed} message="削除しました" onClose={HideRemoved} action={undo} />
--     where
--       undo = Just ("元に戻す", Undo)
--
-- しばらくしたら自動で消すときは、出ているあいだだけ Time.every を購読する:
--
--   subscriptions model
--     | model.saved = Time.every 4000 (always HideSaved)
--     | otherwise   = Sub.none
module Ui.Snackbar (SnackbarProps, snackbar) where

import qualified Ui.Icon as Icon


type SnackbarProps msg =
  { open    :: Bool                            -- 出しているか
  , message :: String                          -- 知らせの文字
  , onClose :: msg                             -- × を押したときに届くメッセージ。open を False にする
  , action  :: Maybe (String, msg) = Nothing   -- 右に出すボタンの文字と、押したときのメッセージ
  }


snackbar :: SnackbarProps msg -> Html msg
snackbar props = <Body visible={props.open} />
  where
    body { visible = True } =
      <div class={css.snackbar} role="status" aria-live="polite">
        <span class={css.message}>{props.message}</span>
        <Action button={props.action} />
        <button class={css.close} type="button" aria-label="閉じる" onClick={props.onClose}><Icon name={Icon.close} /></button>
      </div>
    body { visible = False } = <></>


action :: { button :: Maybe (String, msg) } -> Html msg
action { button = Just (text, msg) } = <button class={css.action} type="button" onClick={msg}>{text}</button>
action { button = Nothing }          = <></>


style
  .snackbar {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 1400;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 288px;
    max-width: calc(100vw - 48px);
    padding: 6px 8px 6px 16px;
    border-radius: var(--radius);
    background: light-dark(#323232, #e0e0e0);
    color: light-dark(#ffffff, rgb(0 0 0 / .87));
    box-shadow: var(--shadow-6);
    font-size: .875rem;
    line-height: 1.43;
    animation: grow .225s var(--ease);
  }
  .message { flex: 1; padding: 8px 0; }
  .action, .close {
    border: none;
    border-radius: var(--radius);
    background: none;
    transition: background-color .15s var(--ease);
  }
  .action {
    padding: 4px 5px;
    color: light-dark(#90caf9, #1565c0);
    font-size: .8125rem;
    font-weight: 500;
    letter-spacing: .02857em;
    text-transform: uppercase;
  }
  .close { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: inherit; font-size: 1.1rem; }
  .action:hover, .close:hover { background: light-dark(rgb(255 255 255 / .08), rgb(0 0 0 / .04)); }
  .action:focus-visible, .close:focus-visible { outline: none; background: light-dark(rgb(255 255 255 / .16), rgb(0 0 0 / .12)); }
  @media (max-width: 600px) {
    .snackbar { right: 8px; bottom: 8px; left: 8px; min-width: 0; max-width: none; }
  }
  @keyframes grow { from { opacity: 0; transform: scale(.8); } }
