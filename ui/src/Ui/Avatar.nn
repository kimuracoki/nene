-- 人を表す丸い印。画像がなければ名前の頭文字を出す
--
--   <Avatar name="Ada Lovelace" />
--   <Avatar name="Ada Lovelace" src={Just user.photo} size={L} />
module Ui.Avatar (AvatarProps, avatar) where


type AvatarProps =
  { name :: String
  , src  :: Maybe String = Nothing
  , size :: Size         = M
  }


avatar :: AvatarProps -> Html msg
avatar props = <Face photo={props.src} />
  where
    look = classes [css.avatar, sizeClass props.size]
    face { photo = Just url } = <img class={look} src={url} alt={props.name} />
    face { photo = Nothing }  = <span class={look} title={props.name} aria-label={props.name}>{initials props.name}</span>


-- "Ada Lovelace" は "AL"。大文字と小文字のない文字（漢字・かな）の名前は、"木村 光" でも "木" の 1 文字だけにする
initials :: String -> String
initials name
  | cased     = String.toUpper (String.join "" (map (String.slice 0 1) (take 2 (words name))))
  | otherwise = String.slice 0 1 name
  where
    first = String.slice 0 1 name
    cased = String.toUpper first /= String.toLower first


sizeClass :: Size -> Class
sizeClass XS = css.small
sizeClass S  = css.small
sizeClass L  = css.large
sizeClass XL = css.large
sizeClass _  = css.medium


style
  .avatar {
    display: inline-grid;
    flex: none;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    object-fit: cover;
    background: light-dark(#bdbdbd, #757575);
    color: var(--background);
    line-height: 1;
    white-space: nowrap;
    user-select: none;
  }
  .small  { width: 24px; height: 24px; font-size: .75rem; }
  .medium { width: 40px; height: 40px; font-size: 1.25rem; }
  .large  { width: 56px; height: 56px; font-size: 1.5rem; }
