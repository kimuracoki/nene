-- チェックボックス
--
--   <Checkbox label="利用規約に同意する" checked={model.agreed} onCheck={Agreed} />
module Ui.Checkbox (CheckboxProps, checkbox) where


type CheckboxProps msg =
  { checked  :: Bool
  , onCheck  :: Bool -> msg
  , label    :: String = ""
  , disabled :: Bool   = False
  }


checkbox :: CheckboxProps msg -> Html msg
checkbox props =
  <label class={css.option}>
    <Row gap={S} align={Center}>
      <input class={css.box} type="checkbox" checked={props.checked} disabled={props.disabled} onCheck={props.onCheck} />
      <span>{props.label}</span>
    </Row>
  </label>


style
  .option { cursor: pointer; user-select: none; }
  .box {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--primary);
    cursor: pointer;
  }
  .box:disabled, .box:disabled + span { opacity: .5; cursor: not-allowed; }
