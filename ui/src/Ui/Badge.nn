-- 子要素の右上に数を重ねる。count が 0 のときは出さない
--
--   <Badge count={model.unread}>
--     <IconButton icon={Icon.mail} label="メール" onClick={OpenMail} />
--   </Badge>
module Ui.Badge (BadgeProps, badge) where

import Ui.Theme (Tone(..), toneVars)


type BadgeProps =
  { count :: Int
  , max   :: Int  = 99     -- これを超えたら 99+ と出す
  , tone  :: Tone = Danger
  }


badge :: BadgeProps -> [Html msg] -> Html msg
badge props children =
  <span class={css.anchor}>
    {children}
    <Count n={props.count} />
  </span>
  where
    colors = toneVars props.tone
    count { n = 0 } = <></>
    count { n }     = <span class={css.badge} vars={colors}>{label n}</span>
    label n
      | n > props.max = show props.max ++ "+"
      | otherwise     = show n


style
  .anchor { position: relative; display: inline-flex; flex: none; vertical-align: middle; }
  .badge {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background: var(--tone);
    color: var(--on-tone);
    font-size: .75rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transform: translate(50%, -50%);
    transform-origin: 100% 0;
  }
