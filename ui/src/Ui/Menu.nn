-- ボタンを押すと開くメニュー。開け閉めはブラウザが受け持つので、model に何も足さなくてよい
-- （外を押すか Esc で閉じ、項目を押すとメッセージが届いて閉じる）
--
--   <Menu id="sort" label="並び替え" items={sortItems} />
--     where
--       sortItems =
--         [ Item { label = "新しい順", onClick = SortBy Newest }
--         , Item { label = "削除", onClick = Remove, icon = Just Icon.delete, tone = Danger }
--         ]
--
-- id は、ページの中でほかと重ならない名前にする
module Ui.Menu (MenuProps, Item, menu) where

import Ui.Button (Variant(..))
import qualified Ui.Icon as Icon
import Ui.Theme (Tone(..), toneVars)


type Item msg =
  { label   :: String
  , onClick :: msg
  , icon    :: Maybe Icon.Icon = Nothing
  , tone    :: Tone            = Neutral
  }

type MenuProps msg =
  { id      :: String
  , label   :: String
  , items   :: [Item msg]
  , variant :: Variant = Outlined
  }


menu :: MenuProps msg -> Html msg
menu props =
  <div class={css.menu} vars={anchor}>
    <button class={trigger} type="button" popovertarget={props.id} aria-haspopup="menu">
      <Row gap={S} align={Center}>
        <span>{props.label}</span>
        <Icon name={Icon.chevronDown} />
      </Row>
    </button>
    <div class={css.list} id={props.id} popover role="menu">
      <Column>{map entry props.items}</Column>
    </div>
  </div>
  where
    anchor = { anchor = "--menu-" ++ props.id }
    trigger = classes [css.trigger, variantClass props.variant]

    -- 項目を押すと、メッセージが届き、メニューが閉じる
    entry item =
      <button class={look} vars={colors} type="button" role="menuitem" popovertarget={props.id} popovertargetaction="hide" onClick={item.onClick}>
        <Row gap={M} align={Center}>
          <Mark icon={item.icon} />
          <span>{item.label}</span>
        </Row>
      </button>
      where
        colors = toneVars item.tone
        -- Neutral の項目は、ふつうの文字の色にする
        look
          | item.tone == Neutral = classes [css.item, css.neutral]
          | otherwise            = css.item


mark :: { icon :: Maybe Icon.Icon } -> Html msg
mark { icon = Just i }  = <Icon name={i} />
mark { icon = Nothing } = <></>


variantClass :: Variant -> Class
variantClass Filled   = css.filled
variantClass Outlined = css.outlined
variantClass Plain    = css.plain


style
  .menu { display: inline-block; anchor-name: var(--anchor); }
  .trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-width: 64px;
    padding: 5px 15px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.75;
    letter-spacing: .02857em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
  }
  .trigger:focus-visible { outline: none; }
  /* 押したときの波紋。押した所（ランタイムが --press-x と --press-y に入れる）から広がり、離すと消える */
  .trigger::after {
    content: "";
    position: absolute;
    left: var(--press-x, 50%);
    top: var(--press-y, 50%);
    width: var(--press-size, 0);
    height: var(--press-size, 0);
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    scale: 0;
    pointer-events: none;
  }
  .trigger[data-pressed]::after { scale: 1; transition: scale .55s var(--ease); }
  .trigger[data-pressed=down]::after { opacity: .3; }
  .trigger[data-pressed=up]::after { transition: scale .55s var(--ease), opacity .55s var(--ease); }
  .filled { background: var(--primary); color: var(--on-tone); box-shadow: var(--shadow-2); }
  .filled:hover { background: color-mix(in srgb, var(--primary) 80%, black); box-shadow: var(--shadow-4); }
  .outlined { border-color: color-mix(in srgb, var(--primary) 50%, transparent); background: none; color: var(--primary); }
  .outlined:hover { border-color: var(--primary); }
  .plain { padding: 5px 7px; background: none; color: var(--primary); }
  .outlined:hover, .plain:hover { background: color-mix(in srgb, var(--primary) 4%, transparent); }
  .outlined:focus-visible, .plain:focus-visible { background: color-mix(in srgb, var(--primary) 12%, transparent); }

  .list {
    min-width: 160px;
    margin: 0;
    padding: 8px 0;
    border: none;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-8);
  }
  /* ボタンのすぐ下に出す。この機能のないブラウザでは、画面の中央に出る */
  @supports (anchor-name: --a) {
    .list {
      position-anchor: var(--anchor);
      inset: auto;
      top: anchor(bottom);
      left: anchor(left);
      margin-top: 4px;
      position-try-fallbacks: flip-block, flip-inline;
    }
  }
  .item {
    width: 100%;
    min-height: 36px;
    padding: 6px 16px;
    border: none;
    background: none;
    color: var(--tone);
    font-size: 1rem;
    line-height: 1.5;
    text-align: left;
    transition: background-color .15s var(--ease);
  }
  .neutral { color: var(--text); }
  .item:hover { background: var(--hover); }
  .item:focus-visible { outline: none; background: var(--selected); }
