-- 見出しを押すと開け閉めできる枠。開け閉めはブラウザが受け持つので、model に何も足さなくてよい
--
--   <Accordion title="よくある質問">…</Accordion>
--   <Accordion title="支払い" group="faq">…</Accordion>   -- 同じ group のものは、1 つだけが開く
module Ui.Accordion (AccordionProps, accordion) where

import qualified Ui.Icon as Icon


type AccordionProps =
  { title :: String
  , open  :: Bool   = False    -- 最初から開いておくか
  , group :: String = ""
  }


accordion :: AccordionProps -> [Html msg] -> Html msg
accordion props children =
  <details class={css.accordion} open={props.open} name={props.group}>
    <summary class={css.summary}>
      <Row gap={S} align={Center}>
        <span class={css.title}>{props.title}</span>
        <Spacer />
        <span class={css.chevron}><Icon name={Icon.chevronDown} /></span>
      </Row>
    </summary>
    <div class={css.body}>{children}</div>
  </details>


style
  /* 続けて並べると、1 枚の面が区切り線で分かれたように見える。開いたものは上下に離れる */
  .accordion {
    position: relative;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-1);
    transition: margin .15s var(--ease);
  }
  .accordion::before {
    content: "";
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--divider);
    transition: opacity .15s var(--ease);
  }
  .accordion:not(.accordion + .accordion) { border-top-left-radius: var(--radius); border-top-right-radius: var(--radius); }
  .accordion:not(.accordion + .accordion)::before { display: none; }
  .accordion:not(:has(+ .accordion)) { border-bottom-left-radius: var(--radius); border-bottom-right-radius: var(--radius); }
  .accordion[open] { margin: 16px 0; border-radius: var(--radius); }
  .accordion[open]:first-child { margin-top: 0; }
  .accordion[open]:last-child { margin-bottom: 0; }
  .accordion[open]::before, .accordion[open] + .accordion::before { opacity: 0; }

  .summary {
    display: block;
    min-height: 48px;
    padding: 12px 16px;
    list-style: none;
    cursor: pointer;
    transition: min-height .15s var(--ease), background-color .15s var(--ease);
  }
  .summary::-webkit-details-marker { display: none; }
  .summary:focus-visible { outline: none; background: var(--selected); }
  .accordion[open] > .summary { padding: 20px 16px; }
  .title { font-size: 1rem; }
  .chevron { display: inline-flex; color: var(--muted); font-size: 1.1875rem; transition: transform .15s var(--ease); }
  .accordion[open] .chevron { transform: rotate(180deg); }
  .body { padding: 0 16px 16px; }
