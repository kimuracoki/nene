-- 選択肢から 1 つを選ぶ丸いボタンの組。options は（値, 表示する文字）の組
--
--   <RadioGroup name="plan" label="プラン" value={model.plan} options={plans} onChange={PlanChanged} />
--     where
--       plans = [("free", "無料"), ("pro", "プロ")]
--
-- name は、ページの中でほかの RadioGroup と重ならない名前にする（矢印キーで選び直せるようになる）
module Ui.RadioGroup (RadioGroupProps, radioGroup) where


type RadioGroupProps msg =
  { name     :: String               -- ページの中でほかと重ならない名前（ラジオボタンを 1 組にする）
  , value    :: String               -- 選んでいる選択肢の値
  , options  :: [(String, String)]   -- （値, 表示する文字）の組
  , onChange :: String -> msg        -- 選んだときに、その選択肢の値を受け取る
  , label    :: String = ""          -- 組の見出し。空なら出さない
  , row      :: Bool   = False       -- True なら横に並べる
  , disabled :: Bool   = False       -- どれも選べない
  }


radioGroup :: RadioGroupProps msg -> Html msg
radioGroup props =
  <fieldset class={css.group} role="radiogroup">
    <Caption text={props.label} />
    <div class={direction}>{map choice props.options}</div>
  </fieldset>
  where
    direction
      | props.row = classes [css.options, css.row]
      | otherwise = css.options
    choice (value, text) =
      <label class={css.option}>
        <input class={css.circle} type="radio" name={props.name} value={value} checked={chosen} disabled={props.disabled} onChange={props.onChange} />
        <span>{text}</span>
      </label>
      where
        chosen = value == props.value


caption :: { text :: String } -> Html msg
caption { text = "" } = <></>
caption { text }      = <legend class={css.caption}>{text}</legend>


style
  .group { min-width: 0; padding: 0; margin: 0; border: 0; }
  .caption { padding: 0; margin-bottom: 2px; color: var(--muted); font-size: .875rem; line-height: 1.4375em; }
  .group:focus-within .caption { color: var(--primary); }
  .options { display: flex; flex-direction: column; }
  .row { flex-flow: row wrap; column-gap: 16px; }
  .option { display: inline-flex; align-items: center; margin-left: -11px; cursor: pointer; user-select: none; }
  /* 42px の丸い当たり判定の中に、20px の丸を描く。選ぶと中の点が大きくなる */
  .circle {
    appearance: none;
    position: relative;
    flex: none;
    width: 42px;
    height: 42px;
    margin: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color .15s var(--ease);
  }
  .circle::before {
    content: "";
    position: absolute;
    inset: 11px;
    border: 2px solid var(--muted);
    border-radius: 50%;
    transition: border-color .15s var(--ease);
  }
  .circle::after {
    content: "";
    position: absolute;
    inset: 11px;
    border-radius: 50%;
    background: var(--primary);
    transform: scale(0);
    transition: transform .15s var(--ease);
  }
  .circle:checked::before { border-color: var(--primary); }
  .circle:checked::after { transform: scale(.5); }
  .circle:hover { background: var(--hover); }
  .circle:checked:hover { background: color-mix(in srgb, var(--primary) 4%, transparent); }
  .circle:focus-visible, .circle:active { outline: none; background: color-mix(in srgb, var(--primary) 12%, transparent); }
  .circle:disabled { cursor: default; background: none; }
  .circle:disabled::before { border-color: var(--disabled); }
  .circle:disabled::after { background: var(--disabled); }
  .circle:disabled + span { color: var(--disabled); cursor: default; }
