-- ボタンを押すと開く、自由な中身の吹き出し。外を押すか Esc で閉じる。model に何も足さなくてよい
--
--   <Popover id="profile" label="プロフィール">
--     <Column gap={S}>…</Column>
--   </Popover>
--
-- id は、ページの中でほかと重ならない名前にする
module Ui.Popover (PopoverProps, popover) where

import Ui.Button (Variant(..))


type PopoverProps =
  { id      :: String
  , label   :: String
  , variant :: Variant = Outlined
  }


popover :: PopoverProps -> [Html msg] -> Html msg
popover props children =
  <div class={css.popover} vars={anchor}>
    <button class={trigger} type="button" popovertarget={props.id}>{props.label}</button>
    <div class={css.panel} id={props.id} popover>{children}</div>
  </div>
  where
    anchor = { anchor = "--popover-" ++ props.id }
    trigger = classes [css.trigger, variantClass props.variant]


variantClass :: Variant -> Class
variantClass Filled   = css.filled
variantClass Outlined = css.outlined
variantClass Plain    = css.plain


style
  .popover { display: inline-block; anchor-name: var(--anchor); }
  .trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-width: 64px;
    padding: 5px 15px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.75;
    letter-spacing: .02857em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
  }
  .trigger:focus-visible { outline: none; }
  /* 押したときの波紋。押した所（ランタイムが --press-x と --press-y に入れる）から広がり、離すと消える */
  .trigger::after {
    content: "";
    position: absolute;
    left: var(--press-x, 50%);
    top: var(--press-y, 50%);
    width: var(--press-size, 0);
    height: var(--press-size, 0);
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    scale: 0;
    pointer-events: none;
  }
  .trigger[data-pressed]::after { scale: 1; transition: scale .55s var(--ease); }
  .trigger[data-pressed=down]::after { opacity: .3; }
  .trigger[data-pressed=up]::after { transition: scale .55s var(--ease), opacity .55s var(--ease); }
  .filled { background: var(--primary); color: var(--on-tone); box-shadow: var(--shadow-2); }
  .filled:hover { background: color-mix(in srgb, var(--primary) 80%, black); box-shadow: var(--shadow-4); }
  .outlined { border-color: color-mix(in srgb, var(--primary) 50%, transparent); background: none; color: var(--primary); }
  .outlined:hover { border-color: var(--primary); }
  .plain { padding: 5px 7px; background: none; color: var(--primary); }
  .outlined:hover, .plain:hover { background: color-mix(in srgb, var(--primary) 4%, transparent); }
  .outlined:focus-visible, .plain:focus-visible { background: color-mix(in srgb, var(--primary) 12%, transparent); }
  .panel {
    min-width: 220px;
    max-width: min(360px, calc(100vw - 32px));
    margin: 0;
    padding: 16px;
    border: none;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-8);
  }
  /* ボタンのすぐ下に出す。この機能のないブラウザでは、画面の中央に出る */
  @supports (anchor-name: --a) {
    .panel {
      position-anchor: var(--anchor);
      inset: auto;
      top: anchor(bottom);
      left: anchor(left);
      margin-top: 6px;
      position-try-fallbacks: flip-block, flip-inline;
    }
  }
