-- 小さなラベル。onClick を渡すと押せるチップ（絞り込みなど）になる
--
--   <Chip tone={Success}>完了</Chip>
--   <Chip selected={isAll} onClick={showAll}>すべて</Chip>
--   <Chip onDelete={remove}>{tag}</Chip>    -- 右に消すボタンが付く
--     where
--       showAll = Just (SetFilter All)
--       remove = Just (RemoveTag tag)
module Ui.Chip (ChipProps, chip) where

import qualified Ui.Icon as Icon
import Ui.Theme (Tone(..), toneVars)


type ChipProps msg =
  { onClick  :: Maybe msg = Nothing   -- Just なら押せるチップになり、押したときにこのメッセージが届く
  , selected :: Bool      = False     -- 選んである印を付ける（絞り込みの選択肢など）
  , tone     :: Tone      = Neutral   -- 色の種類
  , onDelete :: Maybe msg = Nothing   -- Just msg なら、右に消すボタンを付ける
  }


chip :: ChipProps msg -> [Html msg] -> Html msg
chip props children = <Body action={props.onClick} remove={props.onDelete}>{children}</Body>
  where
    -- 押せるチップはボタンに、押せないチップはただの文字にする。消せるチップは、文字と消すボタンを並べる
    body { action, remove = Just msg } kids =
      <span class={deletable} vars={colors}>
        <Main action={action}>{kids}</Main>
        <button class={css.delete} type="button" aria-label="消す" onClick={msg}><Icon name={Icon.cancel} /></button>
      </span>
    body { action = Just msg } kids = <button class={look} vars={colors} type="button" aria-pressed={pressed} onClick={msg}>{kids}</button>
    body { action = Nothing } kids  = <span class={look} vars={colors}>{kids}</span>

    main { action = Just msg } kids = <button class={css.main} type="button" aria-pressed={pressed} onClick={msg}>{kids}</button>
    main { action = Nothing } kids  = <span>{kids}</span>
    deletable = classes [look, css.deletable]

    colors = toneVars props.tone
    -- 押せないチップと選ばれたチップは塗りつぶし、選ばれていない押せるチップは枠だけ
    look = classes [css.chip, fill, grey]
    fill
      | props.selected           = css.filled
      | props.onClick == Nothing = css.filled
      | otherwise                = css.outlined
    grey
      | props.tone == Neutral = css.neutral
      | otherwise             = classes []
    pressed
      | props.selected = "true"
      | otherwise      = "false"


style
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 16px;
    font-size: .8125rem;
    line-height: 1;
    white-space: nowrap;
    transition: background-color .25s var(--ease), box-shadow .25s var(--ease);
  }
  .filled { background: var(--tone); color: var(--on-tone); }
  .outlined { border-color: color-mix(in srgb, var(--tone) 70%, transparent); background: none; color: var(--tone); }
  .neutral.filled { background: var(--selected); color: var(--text); }
  .neutral.outlined { border-color: var(--border); color: var(--text); }

  button.chip { cursor: pointer; }
  /* 押したときの波紋。押した所から広がり、離すと消える */
  button.chip::after {
    content: "";
    position: absolute;
    left: var(--press-x, 50%);
    top: var(--press-y, 50%);
    width: var(--press-size, 0);
    height: var(--press-size, 0);
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    scale: 0;
    pointer-events: none;
  }
  button.chip[data-pressed]::after { scale: 1; transition: scale .55s var(--ease); }
  button.chip[data-pressed=down]::after { opacity: .3; }
  button.chip[data-pressed=up]::after { transition: scale .55s var(--ease), opacity .55s var(--ease); }
  button.filled:hover { background: color-mix(in srgb, var(--tone) 80%, black); }
  button.neutral.filled:hover { background: light-dark(rgb(0 0 0 / .12), rgb(255 255 255 / .24)); }
  button.outlined:hover { background: color-mix(in srgb, var(--tone) 4%, transparent); }
  button.neutral.outlined:hover { background: var(--hover); }
  button.chip:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone) 30%, transparent); }
  button.chip:active { box-shadow: var(--shadow-1); }

  /* 消せるチップ。右の余白を詰め、消すボタンを薄く出す */
  .deletable { padding-right: 4px; }
  .main { padding: 0; border: none; background: none; color: inherit; font: inherit; cursor: pointer; }
  .delete {
    display: inline-flex;
    margin: 0 0 0 -2px;
    padding: 0;
    border: none;
    background: none;
    color: currentColor;
    font-size: 1.1rem;
    opacity: .7;
    cursor: pointer;
    transition: opacity .15s var(--ease);
  }
  .neutral .delete { opacity: .26; }
  .delete:hover { opacity: 1; }
  .neutral .delete:hover { opacity: .4; }
