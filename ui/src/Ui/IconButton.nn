-- アイコンだけのボタン。label は画面には出ず、読み上げとツールチップに使う
--
--   <IconButton icon={Icon.close} label="閉じる" onClick={Close} />
module Ui.IconButton (IconButtonProps, iconButton) where

import Ui.Button (Variant(..))
import qualified Ui.Icon as Icon
import Ui.Theme (Tone(..), toneVars)


type IconButtonProps msg =
  { icon     :: Icon.Icon           -- 出すアイコン
  , label    :: String              -- 読み上げとツールチップに使う名前（画面には出ない）
  , onClick  :: msg                 -- 押したときに届くメッセージ
  , variant  :: Variant = Plain     -- 見た目（Filled・Outlined・Plain）
  , tone     :: Tone    = Neutral   -- 色の種類
  , size     :: Size    = M         -- 大きさ（S・M・L）
  , disabled :: Bool    = False     -- 押せない
  }


iconButton :: IconButtonProps msg -> Html msg
iconButton props =
  <button class={look} vars={colors} type="button" title={props.label} aria-label={props.label} disabled={props.disabled} onClick={props.onClick}>
    <Icon name={props.icon} />
  </button>
  where
    colors = toneVars props.tone
    look = classes [css.iconButton, variantClass props.variant, sizeClass props.size]


variantClass :: Variant -> Class
variantClass Filled   = css.filled
variantClass Outlined = css.outlined
variantClass Plain    = css.plain

sizeClass :: Size -> Class
sizeClass XS = css.small
sizeClass S  = css.small
sizeClass L  = css.large
sizeClass XL = css.large
sizeClass _  = css.medium


style
  .icon-button {
    position: relative;
    display: inline-grid;
    flex: none;
    place-items: center;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 50%;
    color: var(--tone);
    transition: background-color .15s var(--ease), box-shadow .25s var(--ease);
  }
  .icon-button:focus-visible { outline: none; background: color-mix(in srgb, var(--tone) 12%, transparent); }
  .icon-button:disabled { color: var(--disabled); cursor: default; pointer-events: none; }

  /* 押したときの波紋。丸いボタンなので、押した所ではなく中心から広がる（Material Design と同じ） */
  .icon-button::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    scale: 0;
    pointer-events: none;
  }
  .icon-button[data-pressed]::after { scale: 1; transition: scale .55s var(--ease); }
  .icon-button[data-pressed=down]::after { opacity: .3; }
  .icon-button[data-pressed=up]::after { transition: scale .55s var(--ease), opacity .55s var(--ease); }

  .small  { width: 34px; height: 34px; font-size: 1rem; }
  .medium { width: 40px; height: 40px; font-size: 1.1875rem; }
  .large  { width: 48px; height: 48px; font-size: 1.375rem; }
  .plain { background: none; }
  .plain:hover { background: color-mix(in srgb, var(--tone) 4%, transparent); }
  .outlined { border-color: var(--border); background: none; }
  .outlined:hover { background: color-mix(in srgb, var(--tone) 4%, transparent); }
  .filled { background: var(--tone); color: var(--on-tone); box-shadow: var(--shadow-2); }
  .filled:hover { background: color-mix(in srgb, var(--tone) 80%, black); box-shadow: var(--shadow-4); }
  .filled:disabled { background: var(--selected); box-shadow: none; }
