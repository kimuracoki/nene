-- 内容をまとめる面。title を書くと見出しが付く
--
--   <Card title="プロフィール">…</Card>
--   <Card padding={None}>…</Card>       -- 中身を端まで広げる（リストなど）
module Ui.Card (CardProps, card) where


type CardProps =
  { title   :: String = ""   -- 見出し。空なら出さない
  , padding :: Size   = M    -- 中身のまわりの余白。None なら中身を端まで広げる（リストや表を入れるとき）
  }


card :: CardProps -> [Html msg] -> Html msg
card props children =
  <section class={css.card} vars={space}>
    <Column gap={M}>
      <Heading text={props.title} />
      {children}
    </Column>
  </section>
  where
    space = { cardPadding = spacing props.padding, titlePadding = titleSpacing props.padding }


heading :: { text :: String } -> Html msg
heading { text = "" } = <></>
heading { text }      = <h2 class={css.title}>{text}</h2>


-- 中身を端まで広げたカードでも、見出しは端から離す
titleSpacing :: Size -> String
titleSpacing None = "16px 16px 0"
titleSpacing _    = "0"

spacing :: Size -> String
spacing None = "0"
spacing XS   = "var(--space-xs)"
spacing S    = "var(--space-s)"
spacing M    = "var(--space-m)"
spacing L    = "var(--space-l)"
spacing XL   = "var(--space-xl)"


style
  .card {
    padding: var(--card-padding);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-1);
  }
  .title { padding: var(--title-padding); font-size: 1.25rem; font-weight: 500; line-height: 1.6; letter-spacing: .0075em; }
