-- 候補から複数を選べる入力欄。選んだものは欄の中にチップで並び、チップの × で外せる
-- 打った文字（value）と、選んだもの（selected）の 2 つを model に持つ
--
--   <MultiAutocomplete id="tags" label="タグ" value={model.tagText} selected={model.tags} options={allTags} onInput={TagTyped} onChange={TagsChanged} />
--
--   update (TagTyped s) model    = { model | tagText = s }
--   update (TagsChanged ts) model = { model | tags = ts, tagText = "" }    -- 選んだら、打った文字は消すとよい
--
-- 候補を押すと、選んでいなければ足し、選んでいれば外す。一覧は開いたままになる。空の欄で Backspace を押すと、最後に選んだものを外す
-- id は、ページの中でほかと重ならない名前にする
module Ui.MultiAutocomplete (MultiAutocompleteProps, multiAutocomplete) where

import Ui.Button (Variant(..))
import Ui.Chip
import qualified Ui.Icon as Icon


type MultiAutocompleteProps msg =
  { id          :: String
  , value       :: String
  , selected    :: [String]
  , options     :: [String]
  , onInput     :: String -> msg
  , onChange    :: [String] -> msg
  , label       :: String       = ""
  , placeholder :: String       = ""
  , helper      :: String       = ""
  , error       :: Maybe String = Nothing
  , disabled    :: Bool         = False
  , variant     :: Variant      = Outlined   -- 見た目は TextField と同じ
  , noOptions   :: String       = "候補がありません"
  }


multiAutocomplete :: MultiAutocompleteProps msg -> Html msg
multiAutocomplete props =
  <div class={css.field}>
    <div class={box} vars={anchor}>
      <span class={css.chips}>{chips}</span>
      <input class={css.input} id={inputId} type="text" role="combobox" aria-controls={props.id} aria-expanded="false" aria-autocomplete="list" autocomplete="off" value={props.value} placeholder={hint} disabled={props.disabled} aria-invalid={ariaInvalid} onInput={props.onInput} />
      <Floating text={props.label} for={inputId} />
      <fieldset class={css.outline} aria-hidden="true">
        <legend class={css.notch}><Gap text={props.label} /></legend>
      </fieldset>
      <div class={css.buttons}>
        <Clear shown={hasValue} controls={props.id} onClear={cleared} />
        <button type="button" hidden tabindex={-1} aria-controls={props.id} aria-keyshortcuts="Backspace" onClick={dropLast}>最後を外す</button>
        <button class={css.toggle} type="button" tabindex={-1} aria-controls={props.id} aria-haspopup="listbox" aria-label="候補を開く" disabled={props.disabled}>
          <Icon name={Icon.chevronDown} />
        </button>
      </div>
      <div class={css.list} id={props.id} role="listbox" aria-label={props.label} aria-multiselectable="true" popover>
        {choices}
        <Empty none={nothingShown} text={props.noOptions} />
      </div>
    </div>
    <Note helper={props.helper} error={props.error} />
  </div>
  where
    inputId = props.id ++ "-input"
    anchor = { anchor = "--autocomplete-" ++ props.id }
    box = classes [css.box, css.multiple, invalid, labelled, chosen, look props.variant]
    invalid
      | props.error /= Nothing = css.invalid
      | otherwise              = classes []
    labelled
      | props.label /= "" = css.labelled
      | otherwise         = classes []
    -- 選んだものがあれば、ラベルは枠の上に縮める
    chosen
      | null props.selected = classes []
      | otherwise           = css.chosen
    ariaInvalid
      | props.error /= Nothing = "true"
      | otherwise              = "false"
    hint
      | props.placeholder == "" = " "
      | otherwise               = props.placeholder
    hasValue = not (null props.selected) || props.value /= ""
    cleared = props.onChange []
    dropLast = props.onChange (take (length props.selected - 1) props.selected)

    chips = map tag props.selected
    tag t = <Chip onDelete={removed}>{t}</Chip>
      where
        removed = Just (props.onChange (filter (/= t) props.selected))

    shown = filter matches props.options
    matches option = String.contains needle (String.toLower option)
    needle = String.toLower props.value
    nothingShown = null shown
    choices = List.indexedMap choice shown

    choice i option = <div class={css.option} id={optionId} role="option" aria-selected={state} onClick={toggled}>{option}</div>
      where
        optionId = props.id ++ "-" ++ show i
        picked = elem option props.selected
        toggled
          | picked    = props.onChange (filter (/= option) props.selected)
          | otherwise = props.onChange (props.selected ++ [option])
        state
          | picked    = "true"
          | otherwise = "false"


look :: Variant -> Class
look Filled   = css.filled
look Outlined = classes []
look Plain    = css.plain

floating :: { text :: String, for :: String } -> Html msg
floating { text = "" } = <></>
floating { text, for } = <label class={css.label} for={for}>{text}</label>

gap :: { text :: String } -> Html msg
gap { text = "" } = <></>
gap { text }      = <span>{text}</span>

clear :: { shown :: Bool, controls :: String, onClear :: msg } -> Html msg
clear { shown = False }     = <></>
clear { controls, onClear } = <button class={css.clear} type="button" tabindex={-1} aria-controls={controls} aria-label="すべて外す" onClick={onClear}><Icon name={Icon.close} /></button>

empty :: { none :: Bool, text :: String } -> Html msg
empty { none = False } = <></>
empty { text }         = <div class={css.empty}>{text}</div>

note :: { helper :: String, error :: Maybe String } -> Html msg
note { error = Just message } = <span class={css.error}>{message}</span>
note { helper = "" }          = <></>
note { helper }               = <span class={css.helper}>{helper}</span>


style
  .field { display: block; flex: 1; min-width: 0; }
  .box {
    position: relative;
    border-radius: var(--radius);
    anchor-name: var(--anchor);
  }
  .input {
    display: block;
    box-sizing: content-box;
    width: calc(100% - 79px);
    height: 1.4375em;
    padding: 16.5px 65px 16.5px 14px;
    border: 0;
    margin: 0;
    font: inherit;
    color: var(--text);
    background: none;
  }
  .input:focus { outline: none; }
  .input::placeholder { color: var(--muted); opacity: 1; transition: opacity .2s; }
  .labelled .input:not(:focus)::placeholder { opacity: 0; }
  .input:disabled { color: var(--muted); cursor: not-allowed; }

  .label {
    position: absolute;
    top: 0;
    left: 0;
    max-width: calc(100% - 79px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.4375em;
    color: var(--muted);
    pointer-events: none;
    transform: translate(14px, 16.5px) scale(1);
    transform-origin: top left;
    transition: transform .2s cubic-bezier(0, 0, .2, 1), color .2s, max-width .2s;
  }
  .input:focus ~ .label,
  .input:not(:placeholder-shown) ~ .label {
    max-width: calc(133% - 32px);
    transform: translate(14px, -9px) scale(.75);
  }
  .input:focus ~ .label { color: var(--primary); }

  .outline {
    position: absolute;
    inset: -5px 0 0;
    min-width: 0;
    padding: 0 8px;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: inherit;
    overflow: hidden;
    text-align: left;
    pointer-events: none;
    transition: border-color .15s;
  }
  .notch {
    display: block;
    width: auto;
    max-width: .01px;
    height: 11px;
    padding: 0;
    overflow: hidden;
    font-size: .75em;
    white-space: nowrap;
    visibility: hidden;
    transition: max-width 50ms cubic-bezier(0, 0, .2, 1);
  }
  .notch > span { display: inline-block; padding: 0 5px; }
  .input:focus ~ .outline .notch,
  .input:not(:placeholder-shown) ~ .outline .notch {
    max-width: 100%;
    transition: max-width 100ms cubic-bezier(0, 0, .2, 1) 50ms;
  }
  .box:hover .input:not(:disabled) ~ .outline { border-color: var(--text); }
  .input:focus ~ .outline,
  .box:hover .input:focus ~ .outline { border: 2px solid var(--primary); padding: 0 7px; }
  .input:disabled ~ .outline { border-color: color-mix(in srgb, var(--border) 60%, transparent); }

  /* ホバーやフォーカスの色より強くするため、.box.invalid と重ねて書く */
  .invalid .input ~ .label { color: var(--danger); }
  .box.invalid .input ~ .outline { border-color: var(--danger); }

  /* 欄の右の、消すボタンと開くボタン */
  .buttons {
    position: absolute;
    top: calc(50% - 14px);
    right: 9px;
    display: flex;
  }
  .clear, .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    font-size: 1.25rem;
    transition: background-color .15s var(--ease), rotate .2s var(--ease);
  }
  .clear:hover, .toggle:hover { background: var(--hover); }
  .toggle:disabled { color: var(--disabled); cursor: default; background: none; }
  /* 消すボタンは、マウスを載せたときとフォーカスしているときだけ出す */
  .clear { visibility: hidden; }
  .box:hover .clear, .input:focus ~ .buttons .clear { visibility: visible; }
  .input[aria-expanded="true"] ~ .buttons .toggle { rotate: 180deg; }

  /* 候補の一覧。開け閉めはランタイムが受け持ち（input の aria-expanded と popover）、一番上の層で欄のすぐ下に出す */
  .list {
    max-height: 40vh;
    padding: 8px 0;
    margin: 0;
    overflow-y: auto;
    border: none;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-8);
  }
  @supports (anchor-name: --a) {
    .list {
      position-anchor: var(--anchor);
      inset: auto;
      top: anchor(bottom);
      left: anchor(left);
      width: anchor-size(width);
      margin-top: 4px;
      position-try-fallbacks: flip-block;
    }
  }
  .option {
    min-height: 36px;
    padding: 6px 16px;
    line-height: 1.5;
    cursor: pointer;
    transition: background-color .15s var(--ease);
  }
  /* data-active は、矢印キーで選んでいる候補（ランタイムが付ける） */
  .option:hover, .option[data-active] { background: var(--hover); }
  .option[aria-selected="true"] { background: color-mix(in srgb, var(--primary) 8%, transparent); }
  .option[aria-selected="true"]:hover,
  .option[aria-selected="true"][data-active] { background: color-mix(in srgb, var(--primary) 12%, transparent); }
  .empty { padding: 14px 16px; color: var(--muted); }

  .helper, .error {
    display: block;
    margin: 3px 14px 0;
    font-size: .75rem;
    line-height: 1.66;
  }
  .helper { color: var(--muted); }
  .error { color: var(--danger); }


  /* チップと入力欄を、折り返しながら並べる。チップを span で包むのは、数が変わっても入力欄を作り直さない（フォーカスが外れない）ため */
  .chips { display: contents; }
  .multiple {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3px;
    padding: 9px 65px 9px 9px;
  }
  .multiple .input { flex: 1 1 60px; width: 0; min-width: 60px; padding: 7.5px 4px 7.5px 5px; }
  .multiple .label { transform: translate(14px, 16.5px) scale(1); }
  .multiple .input:focus ~ .label,
  .multiple .input:not(:placeholder-shown) ~ .label,
  .chosen .label { transform: translate(14px, -9px) scale(.75); }
  .chosen .outline .notch { max-width: 100%; }
  .chosen.labelled .input:not(:focus)::placeholder { opacity: 1; }
  .option[aria-selected="true"]::before { content: "✓"; display: inline-block; width: 1.5em; color: var(--primary); }
  .option:not([aria-selected="true"])::before { content: ""; display: inline-block; width: 1.5em; }

  /* variant={Filled} は塗った面と下線、variant={Plain} は下線だけ */
  .filled, .plain { border-radius: var(--radius) var(--radius) 0 0; }
  .filled { padding: 21px 65px 4px 8px; background: light-dark(rgb(0 0 0 / .06), rgb(255 255 255 / .09)); transition: background-color .2s var(--ease); }
  .filled:hover { background: light-dark(rgb(0 0 0 / .09), rgb(255 255 255 / .13)); }
  .plain { margin-top: 16px; padding: 2px 56px 2px 0; border-radius: 0; }
  .filled .outline, .plain .outline { display: none; }
  .filled::before, .plain::before, .filled::after, .plain::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
  }
  .filled::before, .plain::before { border-bottom: 1px solid light-dark(rgb(0 0 0 / .42), rgb(255 255 255 / .7)); transition: border-color .2s var(--ease); }
  .filled:hover::before, .plain:hover::before { border-bottom-color: var(--text); }
  .filled::after, .plain::after { border-bottom: 2px solid var(--primary); transform: scaleX(0); transition: transform .2s cubic-bezier(0, 0, .2, 1); }
  .filled:focus-within::after, .plain:focus-within::after { transform: scaleX(1); }
  .invalid.filled::before, .invalid.plain::before { border-bottom-color: var(--danger); }
  .invalid.filled::after, .invalid.plain::after { border-bottom-color: var(--danger); transform: scaleX(1); }
  .filled .input { padding: 6px 4px; }
  .plain .input { padding: 4px 4px 5px 0; }
  .filled .label { transform: translate(12px, 16px) scale(1); }
  .plain .label { transform: translate(0, 4px) scale(1); }
  .filled .input:focus ~ .label,
  .filled .input:not(:placeholder-shown) ~ .label,
  .filled.chosen .label { transform: translate(12px, 7px) scale(.75); }
  .plain .input:focus ~ .label,
  .plain .input:not(:placeholder-shown) ~ .label,
  .plain.chosen .label { transform: translate(0, -17.5px) scale(.75); }
  .plain .buttons { right: 0; }
