-- 進み具合のバー。value は 0 から 1。Nothing なら終わりの見えない処理として動き続ける
--
--   <Progress value={Just 0.4} />
module Ui.Progress (ProgressProps, progress) where

import Ui.Theme (Tone(..), toneVars)


type ProgressProps =
  { value :: Maybe Float = Nothing
  , tone  :: Tone        = Primary
  }


progress :: ProgressProps -> Html msg
progress props = <Bar value={props.value} />
  where
    colors = toneVars props.tone
    bar { value = Just v } =
      <div class={css.track} vars={colors} role="progressbar" aria-valuenow={percent}>
        <div class={css.fill} vars={filled} />
      </div>
      where
        percent = show (round (clamp v * 100.0))
        filled  = { progress = percent ++ "%" }
    bar { value = Nothing } =
      <div class={css.track} vars={colors} role="progressbar">
        <div class={css.first} />
        <div class={css.second} />
      </div>


clamp :: Float -> Float
clamp v = max 0.0 (min 1.0 v)


style
  .track {
    position: relative;
    height: 4px;
    overflow: hidden;
    background: color-mix(in srgb, var(--tone) 30%, var(--surface));
  }
  .fill {
    width: var(--progress);
    height: 100%;
    background: var(--tone);
    transition: width .4s linear;
  }
  /* 終わりの見えない処理。2 本のバーが、速さを変えながら流れる */
  .first, .second {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background: var(--tone);
  }
  .first { animation: first 2.1s cubic-bezier(.65, .815, .735, .395) infinite; }
  .second { animation: second 2.1s cubic-bezier(.165, .84, .44, 1) 1.15s infinite; }
  @keyframes first {
    0% { left: -35%; right: 100%; }
    60%, 100% { left: 100%; right: -90%; }
  }
  @keyframes second {
    0% { left: -200%; right: 100%; }
    60%, 100% { left: 107%; right: -8%; }
  }
