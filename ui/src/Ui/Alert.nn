-- 知らせる枠。色の種類に合ったアイコンが付く
--
--   <Alert tone={Success} title="保存しました">次回からこの設定で開きます。</Alert>
module Ui.Alert (AlertProps, alert) where

import qualified Ui.Icon as Icon
import Ui.Theme (Tone(..), toneVars)


type AlertProps =
  { tone  :: Tone   = Primary   -- 色の種類。知らせの重さに合わせる（Success・Warning・Danger など）
  , title :: String = ""        -- 太字の見出し。空なら出さない
  }


alert :: AlertProps -> [Html msg] -> Html msg
alert props children =
  <div class={css.alert} vars={colors} role="status">
    <Row gap={M}>
      <span class={css.mark}><Icon name={symbol props.tone} /></span>
      <Column>
        <Heading text={props.title} />
        <div class={css.body}>{children}</div>
      </Column>
    </Row>
  </div>
  where
    colors = toneVars props.tone


heading :: { text :: String } -> Html msg
heading { text = "" } = <></>
heading { text }      = <strong class={css.title}>{text}</strong>


symbol :: Tone -> Icon.Icon
symbol Primary = Icon.info
symbol Neutral = Icon.info
symbol Success = Icon.success
symbol Warning = Icon.warning
symbol Danger  = Icon.error


style
  .alert {
    padding: 6px 16px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--tone) 12%, var(--surface));
    color: color-mix(in srgb, var(--tone) 40%, light-dark(black, white));
    font-size: .875rem;
    line-height: 1.43;
    letter-spacing: .01071em;
  }
  .mark { display: flex; padding: 7px 0; color: var(--tone); font-size: 1.1875rem; }
  .title { padding-top: 8px; font-size: 1rem; font-weight: 500; line-height: 1.5; }
  .body { padding: 8px 0; }
  .title + .body { padding-top: 0; }
