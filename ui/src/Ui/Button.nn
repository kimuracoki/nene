-- ボタン
--
--   <Button onClick={Save}>保存</Button>
--   <Button variant={Outlined} tone={Danger} startIcon={Just Icon.delete} onClick={Remove}>削除</Button>
--   <Button loading={model.saving} onClick={Save}>保存</Button>    -- 読み込み中は回る印を出し、押せなくする
module Ui.Button (ButtonProps, Variant(..), button) where

import qualified Ui.Icon as Icon
import Ui.Theme (Tone(..), toneVars)


data Variant
  = Filled     -- 色で塗ったボタン（いちばん目立つ）
  | Outlined   -- 枠だけのボタン
  | Plain      -- 文字だけのボタン（いちばん控えめ）

type ButtonProps msg =
  { onClick   :: msg                         -- 押したときに届くメッセージ
  , variant   :: Variant         = Filled    -- 見た目（Filled・Outlined・Plain）
  , tone      :: Tone            = Primary   -- 色の種類
  , size      :: Size            = M         -- 大きさ（S・M・L）
  , startIcon :: Maybe Icon.Icon = Nothing   -- 文字の前に出すアイコン
  , endIcon   :: Maybe Icon.Icon = Nothing   -- 文字の後に出すアイコン
  , disabled  :: Bool            = False     -- 押せない
  , fullWidth :: Bool            = False     -- 横幅いっぱいに広げる
  , loading   :: Bool            = False     -- True なら、文字の代わりに回る印を出し、押せなくする
  }


button :: ButtonProps msg -> [Html msg] -> Html msg
button props children =
  <button class={look} vars={colors} type="button" disabled={inactive} aria-busy={busy} onClick={props.onClick}>
    <Row gap={S} align={Center} justify={Center}>
      <Slot icon={props.startIcon} />
      {children}
      <Slot icon={props.endIcon} />
    </Row>
  </button>
  where
    colors = toneVars props.tone
    look = classes [css.button, variantClass props.variant, sizeClass props.size, width, waiting]
    width
      | props.fullWidth = css.full
      | otherwise       = classes []
    waiting
      | props.loading = css.loading
      | otherwise     = classes []
    inactive = props.disabled || props.loading
    busy
      | props.loading = "true"
      | otherwise     = "false"


slot :: { icon :: Maybe Icon.Icon } -> Html msg
slot { icon = Just i }  = <Icon name={i} />
slot { icon = Nothing } = <></>


variantClass :: Variant -> Class
variantClass Filled   = css.filled
variantClass Outlined = css.outlined
variantClass Plain    = css.plain

sizeClass :: Size -> Class
sizeClass XS = css.small
sizeClass S  = css.small
sizeClass L  = css.large
sizeClass XL = css.large
sizeClass _  = css.medium


style
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-weight: 500;
    line-height: 1.75;
    letter-spacing: .02857em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease);
  }
  .button:focus-visible { outline: none; }
  .button:disabled { cursor: default; pointer-events: none; }

  /* 押したときの波紋。押した所（ランタイムが --press-x と --press-y に入れる）から広がり、離すと消える */
  .button::after {
    content: "";
    position: absolute;
    left: var(--press-x, 50%);
    top: var(--press-y, 50%);
    width: var(--press-size, 0);
    height: var(--press-size, 0);
    translate: -50% -50%;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    scale: 0;
    pointer-events: none;
  }
  .button[data-pressed]::after { scale: 1; transition: scale .55s var(--ease); }
  .button[data-pressed=down]::after { opacity: .3; }
  .button[data-pressed=up]::after { transition: scale .55s var(--ease), opacity .55s var(--ease); }

  .medium { padding: 5px 15px; font-size: .875rem; }
  .small  { padding: 3px 9px; font-size: .8125rem; }
  .large  { padding: 7px 21px; font-size: .9375rem; }
  .plain.medium { padding: 5px 7px; }
  .plain.small  { padding: 3px 4px; }
  .plain.large  { padding: 7px 10px; }
  .full { width: 100%; }

  .filled {
    background: var(--tone);
    color: var(--on-tone);
    box-shadow: var(--shadow-2);
  }
  .filled:hover { background: color-mix(in srgb, var(--tone) 80%, black); box-shadow: var(--shadow-4); }
  .filled:focus-visible { box-shadow: var(--shadow-6); }
  .filled:active { box-shadow: var(--shadow-8); }
  .filled:disabled { background: var(--selected); color: var(--disabled); box-shadow: none; }

  .outlined {
    border-color: color-mix(in srgb, var(--tone) 50%, transparent);
    background: none;
    color: var(--tone);
  }
  .outlined:hover { border-color: var(--tone); }
  .plain { background: none; color: var(--tone); }
  .outlined:hover, .plain:hover { background: color-mix(in srgb, var(--tone) 4%, transparent); }
  .outlined:focus-visible, .plain:focus-visible { background: color-mix(in srgb, var(--tone) 12%, transparent); }
  .outlined:disabled { border-color: var(--divider); color: var(--disabled); }
  .plain:disabled { color: var(--disabled); }

  /* 読み込み中。文字は場所を取ったまま隠し、真ん中で印を回す（ボタンの幅が変わらない） */
  .loading > * { visibility: hidden; }
  .loading::before {
    content: "";
    position: absolute;
    top: calc(50% - 8px);
    left: calc(50% - 8px);
    width: 16px;
    height: 16px;
    border: 2px solid var(--disabled);
    border-right-color: transparent;
    border-radius: 50%;
    animation: button-spin .8s linear infinite;
  }
  @keyframes button-spin { to { rotate: 360deg; } }
