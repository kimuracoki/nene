-- オンとオフを切り替えるスイッチ
--
--   <Switch label="通知を受け取る" checked={model.notify} onCheck={NotifyChanged} />
module Ui.Switch (SwitchProps, switch) where


type SwitchProps msg =
  { checked  :: Bool
  , onCheck  :: Bool -> msg
  , label    :: String = ""
  , disabled :: Bool   = False
  }


switch :: SwitchProps msg -> Html msg
switch props =
  <label class={css.option}>
    <Row align={Center}>
      <input class={css.track} type="checkbox" role="switch" checked={props.checked} disabled={props.disabled} onCheck={props.onCheck} />
      <span>{props.label}</span>
    </Row>
  </label>


style
  .option { display: inline-block; margin-left: -12px; cursor: pointer; user-select: none; }
  /* 細いトラック（::before）の上を、影の付いた丸いつまみ（::after）が動く */
  .track {
    appearance: none;
    position: relative;
    flex: none;
    width: 58px;
    height: 38px;
    margin: 0;
    cursor: pointer;
  }
  .track::before {
    content: "";
    position: absolute;
    top: 12px;
    left: 12px;
    width: 34px;
    height: 14px;
    border-radius: 7px;
    background: light-dark(rgb(0 0 0 / .38), rgb(255 255 255 / .3));
    transition: background-color .15s var(--ease);
  }
  .track::after {
    content: "";
    position: absolute;
    top: 9px;
    left: 9px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: light-dark(#ffffff, #e0e0e0);
    box-shadow: var(--shadow-1), 0 0 0 9px transparent;
    transition: transform .15s var(--ease), background-color .15s var(--ease), box-shadow .15s var(--ease);
  }
  .track:checked::before { background: color-mix(in srgb, var(--primary) 50%, transparent); }
  .track:checked::after { transform: translateX(20px); background: var(--primary); }
  .track:hover::after { box-shadow: var(--shadow-1), 0 0 0 9px var(--hover); }
  .track:checked:hover::after { box-shadow: var(--shadow-1), 0 0 0 9px color-mix(in srgb, var(--primary) 4%, transparent); }
  .track:focus-visible { outline: none; }
  .track:focus-visible::after, .track:active::after { box-shadow: var(--shadow-1), 0 0 0 9px color-mix(in srgb, var(--primary) 12%, transparent); }
  .track:disabled { cursor: default; }
  .track:disabled::before { opacity: .4; }
  .track:disabled::after { background: light-dark(#f5f5f5, #616161); box-shadow: var(--shadow-1); }
  .track:disabled + span { color: var(--disabled); cursor: default; }
