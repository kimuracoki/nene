-- オンとオフを切り替えるスイッチ
--
--   <Switch label="通知を受け取る" checked={model.notify} onCheck={NotifyChanged} />
module Ui.Switch (SwitchProps, switch) where


type SwitchProps msg =
  { checked  :: Bool
  , onCheck  :: Bool -> msg
  , label    :: String = ""
  , disabled :: Bool   = False
  }


switch :: SwitchProps msg -> Html msg
switch props =
  <label class={css.option}>
    <Row gap={S} align={Center}>
      <input class={css.track} type="checkbox" role="switch" checked={props.checked} disabled={props.disabled} onCheck={props.onCheck} />
      <span>{props.label}</span>
    </Row>
  </label>


style
  .option { cursor: pointer; user-select: none; }
  .track {
    appearance: none;
    position: relative;
    flex: none;
    width: 40px;
    height: 22px;
    margin: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--neutral) 40%, transparent);
    cursor: pointer;
    transition: background-color .2s;
  }
  .track::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 1px 2px rgb(0 0 0 / .25);
    transition: transform .2s;
  }
  .track:checked { background: var(--primary); }
  .track:checked::after { transform: translateX(18px); }
  .track:focus-visible { outline: 3px solid color-mix(in srgb, var(--primary) 35%, transparent); }
  .track:disabled { opacity: .5; cursor: not-allowed; }
