-- 子要素にマウスを載せるか、キーボードで選んだときに出る説明
--
--   <Tooltip text="保存（⌘S）">
--     <IconButton icon={Icon.check} label="保存" onClick={Save} />
--   </Tooltip>
module Ui.Tooltip (TooltipProps, tooltip) where


type TooltipProps =
  { text :: String
  }


tooltip :: TooltipProps -> [Html msg] -> Html msg
tooltip props children =
  <span class={css.anchor}>
    {children}
    <span class={css.tip} role="tooltip">{props.text}</span>
  </span>


style
  .anchor { position: relative; display: inline-flex; }
  .tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    z-index: 50;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--text);
    color: var(--surface);
    font-size: .75rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity .12s, transform .12s;
  }
  .anchor:hover > .tip,
  .anchor:focus-within > .tip {
    opacity: 1;
    transform: translate(-50%, 0);
    transition-delay: .3s;
  }
