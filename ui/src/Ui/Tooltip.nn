-- 子要素にマウスを載せるか、キーボードで選んだときに、下に出る説明
--
--   <Tooltip text="保存（⌘S）">
--     <IconButton icon={Icon.check} label="保存" onClick={Save} />
--   </Tooltip>
module Ui.Tooltip (TooltipProps, tooltip) where


type TooltipProps =
  { text :: String
  }


tooltip :: TooltipProps -> [Html msg] -> Html msg
tooltip props children =
  <span class={css.anchor}>
    {children}
    <span class={css.tip} role="tooltip">{props.text}</span>
  </span>


style
  .anchor { position: relative; display: inline-flex; }
  .tip {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    z-index: 1500;
    max-width: 300px;
    padding: 4px 8px;
    border-radius: var(--radius);
    background: rgb(97 97 97 / .92);
    color: #ffffff;
    font-size: .6875rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%) scale(.75);
    transform-origin: top center;
    transition: opacity .2s var(--ease), transform .15s var(--ease);
  }
  .anchor:hover > .tip,
  .anchor:focus-within > .tip {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    transition-delay: .1s;
  }
